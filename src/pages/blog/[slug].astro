---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
const blogPosts = await getCollection('blog', ({ data}) => {
  return data.draft !== true;
});
  
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

const title = post.data.title;
const publishDate = new Date(post.data.publishDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const { Content, remarkPluginFrontmatter } = await post.render();
---

<Layout title={`${title} - Core Blog`}>
  <Navigation />
  
  <main class="py-20 bg-white dark:bg-gray-900 min-h-screen transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back to blog link -->
      <div class="mb-8">
        <a 
          href="/blog" 
          class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-semibold"
        >
          <Icon name="heroicons:chevron-left" class="mr-2 h-4 w-4" />
          Back to Blog
        </a>
      </div>

      <!-- Article header -->
      <header class="mb-16">
        <div class="text-center">
          <div class="flex items-center justify-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6">
            <time>{publishDate}</time>
            <span>•</span>
            <span>{remarkPluginFrontmatter.minutesRead}</span>
            {post.data.featured && (
              <>
                <span>•</span>
                <span class="bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 px-3 py-1 rounded-full text-xs font-semibold">
                  Featured
                </span>
              </>
            )}
          </div>
          
          <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-gray-100 mb-8 leading-tight">
            {title}
          </h1>
          
          <p class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto leading-relaxed">
            {post.data.description}
          </p>
          
          {post.data.tags && (
            <div class="flex flex-wrap justify-center gap-3 mb-8">
              {post.data.tags.map((tag: string) => (
                <span class="px-4 py-2 bg-primary-100 dark:bg-primary-900 text-primary-800 dark:text-primary-200 rounded-full font-medium text-sm">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- Article content -->
      <article class="prose prose-lg prose-slate dark:prose-invert max-w-none prose-headings:scroll-mt-24">
        <div class="blog-content">
          <Content />
        </div>
      </article>

      <!-- Article footer -->
      <footer class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-700">
        <div class="flex justify-center">
          <div class="flex space-x-4">
            <a 
              href="https://github.com/coredev-uk" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
            >
              <span class="sr-only">GitHub</span>
              <Icon name="mdi:github" class="h-6 w-6" />
            </a>
            <a 
              href="https://linkedin.com/in/coredev-uk" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
            >
              <span class="sr-only">LinkedIn</span>
              <Icon name="mdi:linkedin" class="h-6 w-6" />
            </a>
            <a 
              href="https://x.com/coredev_uk" 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
            >
              <span class="sr-only">X (Twitter)</span>
              <Icon name="simple-icons:x" class="h-6 w-6" />
            </a>
          </div>
        </div>
      </footer>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @reference "tailwindcss";
  
  /* Hide the first h1 in blog content since we display the title in the header */
  .blog-content > :global(h1:first-child) {
    display: none;
  }
  
  /* Improve spacing for the first element after removing h1 */
  .blog-content > :global(*:first-child) {
    margin-top: 0;
  }
  
  /* Better prose styling */
  .prose :global(h2) {
    @apply text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-100 mt-12 mb-6 border-b border-gray-200 dark:border-gray-700 pb-2;
  }
  
  .prose :global(h3) {
    @apply text-xl md:text-2xl font-semibold text-gray-900 dark:text-gray-100 mt-8 mb-4;
  }
  
  .prose :global(h4) {
    @apply text-lg md:text-xl font-semibold text-gray-900 dark:text-gray-100 mt-6 mb-3;
  }
  
  .prose :global(p) {
    @apply mb-6 leading-relaxed;
  }
  
  .prose :global(blockquote) {
    @apply border-l-4 border-blue-500 pl-6 my-8 italic text-gray-700 dark:text-gray-300;
  }
  
  .prose :global(code) {
    @apply bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded text-sm;
  }
  
  .prose :global(pre) {
    @apply bg-gray-900 dark:bg-gray-800 rounded-lg p-6 overflow-x-auto my-8;
  }
  
  .prose :global(pre code) {
    @apply bg-transparent p-0;
  }
</style>
