---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import ContentsRail from '../../components/ContentsRail.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, publishDate, tags, image, imageAlt } = post.data;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const published = new Date(publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={`${title}, Paul Thompson (Core)`} description={description}>
  <Navigation />
  <main id="main-content" class="doc grid12 wrap">
    <a class="back" href="/blog">
      <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"
        ><path d="M10 3.5 5.5 8 10 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
        ></path></svg
      >
      All writing
    </a>

    <header class="doc__head">
      <h1 class="display" data-reveal>{title}</h1>
      <p class="lead doc__lead" data-reveal style="--d: 90ms">{description}</p>
    </header>

    <dl class="facts plate" aria-label="About this post" data-reveal style="--d: 180ms">
      <div>
        <dt class="label">Published</dt>
        <dd><time datetime={publishDate}>{published}</time></dd>
      </div>
      <div>
        <dt class="label">Length</dt>
        <dd>{remarkPluginFrontmatter.minutesRead}</dd>
      </div>
      {
        tags && (
          <div>
            <dt class="label">Topics</dt>
            <dd>{tags.join(', ')}</dd>
          </div>
        )
      }
    </dl>

    {
      image && (
        <figure class="window doc__picture" data-reveal="settle" style="--d: 270ms">
          <div class="window__frame">
            <img src={image} alt={imageAlt ?? ''} fetchpriority="high" />
          </div>
        </figure>
      )
    }

    <article class="prose prose-room doc__body post__body">
      <Content />
    </article>

    <aside class="doc__aside" aria-label="Contents">
      <ContentsRail headings={headings} />
    </aside>

    <a class="next plate" href="/projects">
      <span>
        <span class="label">Next</span>
        <span class="next__title">All projects</span>
      </span>
      <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </main>
  <Footer />
</Layout>

<style>
  /* Posts open with their own "# Title"; the header already shows it. */
  .post__body > :global(h1:first-child) {
    display: none;
  }
</style>
