---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.draft !== true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, publishDate, tags, image, imageAlt } = post.data;
const { Content, remarkPluginFrontmatter } = await render(post);
const published = new Date(publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={`${title}, Paul Thompson (Core)`} description={description}>
  <Navigation />
  <main id="main-content" class:list={['post wrap', { 'post--picture': image }]}>
    <header class="post__head">
      <h1 data-reveal>{title}</h1>
      <p class="post__lead" data-reveal style="--i: 1">{description}</p>
    </header>

    {
      image && (
        <figure class="post__picture" data-reveal style="--i: 2">
          <img src={image} alt={imageAlt ?? ''} fetchpriority="high" />
        </figure>
      )
    }

    <aside class="post__aside" aria-label="About this post">
      <dl>
        <div data-reveal style="--i: 3">
          <dt>Published</dt>
          <dd><time datetime={publishDate}>{published}</time></dd>
        </div>
        <div data-reveal style="--i: 4">
          <dt>Length</dt>
          <dd>{remarkPluginFrontmatter.minutesRead}</dd>
        </div>
        {
          tags && (
            <div data-reveal style="--i: 5">
              <dt>Topics</dt>
              <dd>{tags.join(', ')}</dd>
            </div>
          )
        }
      </dl>
      <p class="post__links">
        <a class="link" href="/blog" data-reveal style="--i: 6">All writing</a>
        <a class="link" href="/projects" data-reveal style="--i: 7">Projects</a>
      </p>
    </aside>

    <article class="prose prose-room post__body">
      <Content />
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .post {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    padding-top: 9rem;
    padding-bottom: var(--section-gap);
  }

  .post__head {
    grid-column: 1 / span 8;
    grid-row: 1;
  }

  h1 {
    margin: 0;
    font-size: var(--step-display);
    line-height: 1;
  }

  .post__lead {
    max-width: 46ch;
    margin: 1.5rem 0 0;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .post__picture {
    grid-column: 1 / span 8;
    grid-row: 2;
    margin: 4rem 0 0;
  }

  .post__picture img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* Facts hold the right columns while the post scrolls. */
  .post__aside {
    grid-column: 9 / -1;
    grid-row: 1 / span 2;
    align-self: start;
    position: sticky;
    top: 2rem;
    display: grid;
    gap: 2rem;
  }

  .post--picture .post__aside {
    grid-row: 2 / span 2;
    margin-top: 4rem;
  }

  .post__aside dl {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .post__aside dt {
    color: var(--muted);
    font-size: var(--step-small);
  }

  .post__aside dd {
    margin: 0.25rem 0 0;
  }

  .post__aside p {
    margin: 0;
  }

  .post__links {
    display: flex;
    gap: 1.5rem;
  }

  .post__body {
    grid-column: 1 / span 7;
    grid-row: 2;
    margin-top: 4rem;
  }

  .post--picture .post__body {
    grid-row: 3;
  }

  /* Posts open with their own "# Title"; the header already shows it. */
  .post__body > :global(h1:first-child) {
    display: none;
  }

  @media (max-width: 960px) {
    .post__head,
    .post__picture,
    .post__aside,
    .post__body,
    .post--picture .post__aside,
    .post--picture .post__body {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .post__aside {
      position: static;
      margin-top: 3rem;
    }

    .post__aside dl {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
      column-gap: var(--gutter);
    }

    .post__body {
      margin-top: 3rem;
    }
  }
</style>
