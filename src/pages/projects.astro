---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ProjectList from '../components/ProjectList.astro';
import ProjectFigure from '../components/ProjectFigure.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { statusLabel } from '../utils/projectStatus';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime();
});
---

<Layout title="Projects, Paul Thompson (Core)">
  <Navigation />
  <main id="main-content">
    <header class="head grid12 wrap">
      <div class="head__text">
        <h1 class="display" data-reveal>Projects</h1>
        <p class="lead" data-reveal style="--d: 90ms">
          Write-ups of the three I have spent the most time on, then everything else I have built, most of it public on
          GitHub.
        </p>
      </div>
      <figure class="window head__picture" data-reveal="settle" style="--d: 180ms">
        <div class="window__frame">
          <img
            src="/work/cider-2-settings.webp"
            width="840"
            height="509"
            alt="Cider 2.3's settings over the library: the Visual page with General, Sweetener, Animated Artwork, Lyrics and Fonts."
            fetchpriority="high"
          />
        </div>
        <figcaption>Cider 2, the settings window</figcaption>
      </figure>
    </header>

    <div class="entries wrap section">
      {
        projects.map((project) => (
          <article class="entry grid12">
            <div class="entry__text">
              <h2>
                <a href={`/projects/${project.id}`}>{project.data.title}</a>
              </h2>
              <p class="entry__meta">
                {project.data.date && <span>{new Date(project.data.date).getFullYear()}</span>}
                {project.data.status && (
                  <span class:list={{ on: project.data.status === 'active' }}>
                    {project.data.status === 'active' && <span class="on-dot" aria-hidden="true" />}
                    {statusLabel[project.data.status]}
                  </span>
                )}
              </p>
              <p class="entry__desc">{project.data.description}</p>
              {project.data.technologies && (
                <p class="entry__stack">{project.data.technologies.slice(0, 4).join(', ')}</p>
              )}
              <p class="actions entry__links">
                <a class="btn btn--secondary btn--small" href={`/projects/${project.id}`}>
                  Read the write-up
                </a>
                {project.data.github && (
                  <a class="btn btn--secondary btn--small" href={project.data.github}>
                    Source on GitHub
                  </a>
                )}
              </p>
            </div>
            <div class="entry__figure">
              <ProjectFigure slug={project.id} image={project.data.image} imageAlt={project.data.imageAlt} />
            </div>
          </article>
        ))
      }
    </div>

    <ProjectList id="all" heading="Everything else" />
  </main>
  <Footer />
</Layout>

<style>
  .head {
    align-items: end;
    row-gap: 2.5rem;
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .head__text {
    grid-column: 1 / span 5;
  }

  .head__text .lead {
    max-width: 30ch;
    margin: 1.5rem 0 0;
  }

  .head__picture {
    grid-column: 7 / -1;
  }

  .head__picture img {
    aspect-ratio: 840 / 509;
    object-fit: cover;
  }

  .entries {
    display: grid;
    gap: clamp(4.5rem, 9vw, 7rem);
  }

  .entry {
    align-items: center;
    row-gap: 1.75rem;
  }

  .entry__text {
    grid-column: 1 / span 5;
  }

  .entry__figure {
    grid-column: 7 / -1;
  }

  .entry h2 {
    font-size: var(--fs-h2);
  }

  .entry h2 a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    transition: text-decoration-color var(--t-state) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .entry h2 a:hover {
      text-decoration-color: var(--rule);
    }
  }

  .entry__text p {
    margin: 0;
  }

  .entry__text .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 10px;
    color: var(--text2);
    font-size: 0.9375rem;
  }

  .entry__text .entry__desc {
    margin-top: 18px;
    font-size: 1.1875rem;
    line-height: 1.45;
  }

  .entry__text .entry__stack {
    margin-top: 12px;
    color: var(--text2);
    font-size: 0.9375rem;
  }

  .entry__text .entry__links {
    margin-top: 24px;
  }

  @media (max-width: 900px) {
    .head__text,
    .head__picture,
    .entry__text,
    .entry__figure {
      grid-column: 1 / -1;
    }
  }
</style>
