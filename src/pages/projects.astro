---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import ProjectList from '../components/ProjectList.astro';
import ProjectFigure from '../components/ProjectFigure.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { statusLabel } from '../utils/projectStatus';

const projects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime();
});
---

<Layout title="Projects, Paul Thompson (Core)">
  <Navigation />
  <main id="main-content">
    <header class="head wrap">
      <div class="head__text">
        <h1 data-reveal>Projects</h1>
        <p data-reveal style="--i: 1">
          Write-ups of the three I have spent the most time on, then everything else I have built, most of it public on
          GitHub.
        </p>
      </div>
      <figure class="head__picture">
        <img
          src="/work/cider-2-settings.webp"
          width="840"
          height="509"
          alt="Cider 2.3's settings over the library: the Visual page with General, Sweetener, Animated Artwork, Lyrics and Fonts."
          fetchpriority="high"
        />
        <figcaption>Cider 2, the settings window</figcaption>
      </figure>
    </header>

    <div class="entries wrap section">
      {
        projects.map((project) => (
          <article class="entry">
            <div class="entry__text">
              <h2 data-reveal>
                <a href={`/projects/${project.id}`}>{project.data.title}</a>
              </h2>
              <p class="entry__desc" data-reveal style="--i: 1">
                {project.data.description}
              </p>
              <p class="entry__meta" data-reveal style="--i: 2">
                {[
                  project.data.date && new Date(project.data.date).getFullYear(),
                  project.data.status && statusLabel[project.data.status],
                  project.data.technologies?.slice(0, 4).join(', '),
                ]
                  .filter(Boolean)
                  .join('. ')}
              </p>
              <p class="entry__links" data-reveal style="--i: 3">
                <a class="link" href={`/projects/${project.id}`}>
                  Read the write-up
                </a>
                {project.data.github && (
                  <a class="link" href={project.data.github}>
                    Source on GitHub
                  </a>
                )}
              </p>
            </div>
            <div class="entry__figure">
              <ProjectFigure slug={project.id} image={project.data.image} imageAlt={project.data.imageAlt} />
            </div>
          </article>
        ))
      }
    </div>

    <ProjectList id="all" heading="Everything else" />
  </main>
  <Footer />
</Layout>

<style>
  .head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2.5rem;
    align-items: end;
    padding-top: 8rem;
  }

  .head__text {
    grid-column: 1 / span 4;
  }

  .head h1 {
    margin: 0;
    font-size: var(--step-display);
    line-height: 1;
  }

  .head__text p {
    max-width: 30ch;
    margin: 1.5rem 0 0;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .head__picture {
    grid-column: 5 / -1;
    margin: 0;
  }

  .head__picture img {
    width: 100%;
    aspect-ratio: 840 / 509;
    object-fit: cover;
  }

  .head__picture figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: var(--step-small);
  }

  .entries {
    display: grid;
    gap: clamp(4rem, 8vw, 6rem);
  }

  .entry {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 1.5rem;
    align-items: center;
  }

  .entry__text {
    grid-column: 1 / span 5;
  }

  .entry__figure {
    grid-column: 7 / -1;
  }

  .entry h2 {
    margin: 0 0 0.75rem;
    font-size: var(--step-head);
  }

  .entry h2 a {
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .entry h2 a:hover {
      color: var(--accent);
    }
  }

  .entry__desc {
    margin: 0 0 0.75rem;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .entry__meta {
    margin: 0 0 1.25rem;
    color: var(--muted);
  }

  .entry__links {
    display: flex;
    gap: 1.5rem;
    margin: 0;
  }

  @media (max-width: 640px) {
    .head__text,
    .head__picture,
    .entry__text,
    .entry__figure {
      grid-column: 1 / -1;
    }

    .head {
      padding-top: 6.5rem;
    }
  }
</style>
