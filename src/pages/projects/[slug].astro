---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import ProjectFigure from '../../components/ProjectFigure.astro';
import ContentsRail from '../../components/ContentsRail.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { statusLabel } from '../../utils/projectStatus';
import { getReadouts } from '../../utils/kromgo';

export async function getStaticPaths() {
  // The same order as the projects page, so "Next write-up" walks it.
  const projects = (await getCollection('projects')).sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime();
  });
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined },
  }));
}

const { project, next } = Astro.props;
const { title, description, date, technologies, github, demo, status, image, imageAlt, gallery, badges } = project.data;
const { Content, headings } = await render(project);
const since = date ? new Date(date).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' }) : null;
const readouts = badges ? await getReadouts(badges) : null;
---

<Layout title={`${title}, Paul Thompson (Core)`} description={description}>
  <Navigation />
  <main id="main-content" class="doc grid12 wrap">
    <a class="back" href="/projects">
      <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true"
        ><path d="M10 3.5 5.5 8 10 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
        ></path></svg
      >
      All projects
    </a>

    <header class="doc__head">
      <h1 class="display" data-reveal>{title}</h1>
      <p class="lead doc__lead" data-reveal style="--d: 90ms">{description}</p>
    </header>

    <dl class="facts plate" data-reveal style="--d: 180ms">
      {
        since && (
          <div>
            <dt class="label">Started</dt>
            <dd>{since}</dd>
          </div>
        )
      }
      {
        status && (
          <div>
            <dt class="label">Status</dt>
            <dd>
              {status === 'active' ? (
                <span class="on">{statusLabel[status]}</span>
              ) : (
                statusLabel[status]
              )}
            </dd>
          </div>
        )
      }
      {
        technologies && (
          <div>
            <dt class="label">Built with</dt>
            <dd>{technologies.join(', ')}</dd>
          </div>
        )
      }
    </dl>

    {
      image && (
        <figure class="window doc__picture" data-reveal="settle" style="--d: 270ms">
          <div class="window__frame">
            <img src={image} alt={imageAlt ?? ''} fetchpriority="high" />
          </div>
        </figure>
      )
    }

    <article class="prose prose-room doc__body">
      <Content />
    </article>

    <aside class="doc__aside" aria-label="Project facts">
      {
        (github || demo) && (
          <p class="actions">
            {github && (
              <a class="btn btn--primary" href={github}>
                Source on GitHub
              </a>
            )}
            {demo && (
              <a class="btn btn--secondary" href={demo}>
                Project site
              </a>
            )}
          </p>
        )
      }

      {
        readouts ? (
          <section class="readouts plate" aria-labelledby="readouts-title">
            <h2 class="label readouts__head" id="readouts-title">
              From the cluster <span>at build time</span>
            </h2>
            <dl>
              {readouts.map((r) =>
                r.level !== undefined ? (
                  <div class="readouts__level">
                    <dt>{r.label}</dt>
                    <dd>
                      <span class="track" aria-hidden="true">
                        <span style={`--v: ${r.level}%`} />
                      </span>
                      <span>{r.value}</span>
                    </dd>
                  </div>
                ) : (
                  <div>
                    <dt>{r.label}</dt>
                    <dd class:list={{ [`state-${r.state}`]: r.state }}>{r.value}</dd>
                  </div>
                ),
              )}
            </dl>
          </section>
        ) : (
          badges && (
            <div class="badges">
              <p class="label">From the cluster</p>
              <ul>
                {badges.map((badge) => (
                  <li>
                    <img src={badge.src} alt={badge.alt} height="20" loading="lazy" decoding="async" />
                  </li>
                ))}
              </ul>
            </div>
          )
        )
      }

      <ProjectFigure slug={project.id} />

      <ContentsRail headings={headings} />
    </aside>

    {
      gallery && (
        <section class="gallery" aria-labelledby="gallery-title">
          <h2 id="gallery-title" class="section-title">Screens</h2>
          <div class="gallery__shots">
            {gallery.map((shot) => (
              <figure class="window">
                <div class="window__frame">
                  <img src={shot.src} alt={shot.alt} loading="lazy" />
                </div>
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      next && (
        <a class="next plate" href={`/projects/${next.id}`}>
          <span>
            <span class="next__title">{next.data.title}</span>
            <span class="next__sub">Next write-up</span>
          </span>
          <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  /* Readouts: the cluster's numbers as the shell shows them. */
  .readouts {
    padding: 6px 16px 12px;
    font-size: 0.9375rem;
  }

  .readouts__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0 8px;
  }

  .readouts__head span {
    font-weight: 400;
  }

  .readouts dl {
    margin: 0;
  }

  .readouts dl > div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 12px;
    min-height: 36px;
    padding: 6px 0;
    border-top: 1px solid var(--rule);
  }

  .readouts dt {
    color: var(--text2);
  }

  .readouts dd {
    margin: 0;
    text-align: right;
  }

  /* A level row: the label, then the track and its value beneath it, as the shell's slider rows read. */
  .readouts dl > .readouts__level {
    grid-template-columns: minmax(0, 1fr);
    row-gap: 6px;
    padding-block: 10px;
  }

  .readouts__level dd {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: 12px;
  }

  /* A level: the shell's slider track, 4px inset, enamel fill. */
  .track {
    display: block;
    height: 4px;
    overflow: hidden;
    border-radius: var(--r-track);
    background: var(--inset);
  }

  .track span {
    display: block;
    width: var(--v);
    height: 100%;
    border-radius: var(--r-track);
    background: var(--fill);
  }

  .state-ok {
    color: var(--ok);
  }

  .state-alert {
    color: var(--alert);
  }

  .badges ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .badges img {
    width: auto;
    height: 20px;
  }

  .gallery {
    grid-column: 1 / -1;
    margin-top: var(--section-gap);
  }

  .gallery__shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    margin-top: 2rem;
  }

  .gallery__shots img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 0 0;
  }

  @media (max-width: 960px) {
    .gallery__shots {
      grid-template-columns: 1fr;
    }
  }
</style>
