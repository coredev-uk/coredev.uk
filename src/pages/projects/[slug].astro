---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import ProjectFigure from '../../components/ProjectFigure.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { statusLabel } from '../../utils/projectStatus';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, date, technologies, github, demo, status, image, imageAlt, gallery, badges } = project.data;
const { Content } = await project.render();
const since = date ? new Date(date).toLocaleDateString('en-GB', { month: 'long', year: 'numeric' }) : null;
const facts = [
  since && { term: 'Started', value: since },
  status && { term: 'Status', value: statusLabel[status] },
  technologies && { term: 'Built with', value: technologies.join(', ') },
].filter((fact): fact is { term: string; value: string } => Boolean(fact));
---

<Layout title={`${title}, Paul Thompson (Core)`} description={description}>
  <Navigation />
  <main id="main-content" class:list={['detail wrap', { 'detail--picture': image }]}>
    <header class="detail__head">
      <h1 data-reveal>{title}</h1>
      <p class="detail__lead" data-reveal style="--i: 1">{description}</p>
    </header>
    {
      image && (
        <figure class="detail__picture" data-reveal style="--i: 2">
          <img src={image} alt={imageAlt ?? ''} fetchpriority="high" />
        </figure>
      )
    }

    <aside class="detail__aside" aria-label="Project facts">
      <dl class="detail__facts">
        {
          facts.map((fact, i) => (
            <div data-reveal style={`--i: ${i + 2}`}>
              <dt>{fact.term}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      {
        badges && (
          <div class="detail__live" data-reveal style="--i: 5">
            <p>Live from the cluster</p>
            <ul>
              {badges.map((badge) => (
                <li>
                  <img src={badge.src} alt={badge.alt} height="20" loading="lazy" decoding="async" />
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        (github || demo) && (
          <p class="detail__actions" data-reveal style="--i: 5">
            {github && (
              <a class="button" href={github}>
                Source on GitHub
              </a>
            )}
            {demo && (
              <a class="link" href={demo}>
                Project site
              </a>
            )}
          </p>
        )
      }
      <div data-reveal style="--i: 6">
        <ProjectFigure slug={project.slug} />
      </div>
    </aside>

    <article class="prose prose-room detail__body">
      <Content />
    </article>

    {
      gallery && (
        <section class="detail__gallery" aria-labelledby="gallery-title">
          <h2 id="gallery-title">Screens</h2>
          <div class="detail__shots">
            {gallery.map((shot, i) => (
              <figure data-reveal style={`--i: ${i}`}>
                <img src={shot.src} alt={shot.alt} loading="lazy" />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <p class="detail__back" data-reveal><a class="link" href="/projects">All projects</a></p>
  </main>
  <Footer />
</Layout>

<style>
  .detail {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    padding-top: 9rem;
    padding-bottom: var(--section-gap);
  }

  .detail__head {
    grid-column: 1 / span 7;
    grid-row: 1;
  }

  .detail__head h1 {
    margin: 0;
    font-size: var(--step-display);
    line-height: 1;
  }

  .detail__lead {
    max-width: 40ch;
    margin: 1.5rem 0 0;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  /* Facts, links and the project's picture hold the right columns while the write-up scrolls. */
  .detail__aside {
    grid-column: 9 / -1;
    grid-row: 1 / span 2;
    align-self: start;
    position: sticky;
    top: 2rem;
    display: grid;
    gap: 2rem;
  }

  .detail__facts {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .detail__facts dt {
    color: var(--muted);
    font-size: var(--step-small);
  }

  .detail__facts dd {
    margin: 0.25rem 0 0;
  }

  .detail__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0;
  }

  .detail__live p {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: var(--step-small);
  }

  .detail__live ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail__live img {
    display: block;
    width: auto;
    height: 20px;
  }

  .detail__picture {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 4rem 0 0;
  }

  .detail__picture img {
    width: 100%;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    object-position: 0 0;
  }

  /* With a picture row, the facts sit beside the write-up below it. */
  .detail--picture .detail__aside {
    grid-row: 3;
    margin-top: 4rem;
  }

  .detail--picture .detail__body {
    grid-row: 3;
  }

  .detail__body {
    grid-column: 1 / span 7;
    grid-row: 2;
    margin-top: 4rem;
  }

  .detail__gallery {
    grid-column: 1 / -1;
    margin-top: var(--section-gap);
  }

  .detail__gallery h2 {
    margin: 0 0 1.5rem;
    font-size: var(--step-head);
  }

  .detail__shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
  }

  .detail__shots figure {
    margin: 0;
  }

  .detail__shots img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 0 0;
  }

  .detail__shots figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: var(--step-small);
  }

  .detail__back {
    grid-column: 1 / span 7;
    margin: 4rem 0 0;
  }

  @media (max-width: 960px) {
    .detail__head,
    .detail__picture,
    .detail__aside,
    .detail__body,
    .detail--picture .detail__aside,
    .detail--picture .detail__body,
    .detail__back {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .detail__aside {
      position: static;
      margin-top: 3rem;
    }

    .detail__facts {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
      column-gap: var(--gutter);
    }

    .detail__shots {
      grid-template-columns: 1fr;
    }
  }
</style>
