---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { getStatusClasses } from '../../utils/projectStatus';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { slug } = Astro.params;

const title = project.data.title;
const { Content } = await project.render();
---

<Layout title={`${title} - Core Projects`}>
  <Navigation />
  
  <main class="py-20 bg-white dark:bg-gray-900 min-h-screen transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Back to projects link -->
      <div class="mb-8">
        <a 
          href="/projects" 
          class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-semibold"
        >
          <Icon name="heroicons:chevron-left" class="mr-2 h-4 w-4" />
          Back to Projects
        </a>
      </div>

      <!-- Project header -->
      <header class="mb-12">
        <div class="flex items-center gap-4 mb-6">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-gray-100 leading-tight">
            {title}
          </h1>
          {project.data.featured && (
            <span class="bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 px-3 py-1 rounded-full text-sm font-semibold">
              Featured
            </span>
          )}
        </div>
        
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
          {project.data.description}
        </p>
        
        <!-- Project meta -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
          <div>
            <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2">Status</h3>
            <span class={`capitalize inline-block px-3 py-1 rounded-full text-sm font-semibold ${
              getStatusClasses(project.data.status)
            }`}>
              {project.data.status}
            </span>
          </div>
          
          <div>
            <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2">Date</h3>
            <p class="text-gray-600 dark:text-gray-300">
              {new Date(project.data.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long'
              })}
            </p>
          </div>
          
          <div>
            <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2">Technologies</h3>
            <div class="flex flex-wrap gap-1">
              {project.data.technologies?.slice(0, 2).map((tech: string) => (
                <span class="px-2 py-1 bg-primary-100 dark:bg-primary-900 text-primary-800 dark:text-primary-200 text-xs rounded-full">
                  {tech}
                </span>
              ))}
              {project.data.technologies?.length > 2 && (
                <span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300 text-xs rounded-full">
                  +{project.data.technologies.length - 2}
                </span>
              )}
            </div>
          </div>
        </div>
        
        <!-- Action buttons -->
        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          {project.data.github && (
            <a 
              href={project.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center bg-gray-900 dark:bg-gray-700 text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-800 dark:hover:bg-gray-600 transition-colors"
            >
              <Icon name="mdi:github" class="mr-2 h-5 w-5" />
              View Source
            </a>
          )}
          
          {project.data.demo && (
            <a 
              href={project.data.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center bg-primary-600 dark:bg-primary-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-primary-700 dark:hover:bg-primary-600 transition-colors"
            >
              <Icon name="heroicons:arrow-top-right-on-square" class="mr-2 h-5 w-5" />
              Live Demo
            </a>
          )}
        </div>

        <!-- Technologies used -->
        {project.data.technologies && (
          <div class="mb-8">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3">Technologies Used</h3>
            <div class="flex flex-wrap gap-2">
              {project.data.technologies.map((tech: string) => (
                <span class="px-4 py-2 bg-primary-100 dark:bg-primary-900 text-primary-800 dark:text-primary-200 rounded-lg font-medium">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        )}
      </header>

      <!-- Project image -->
      {project.data.image && (
        <div class="mb-12">
          <img 
            src={project.data.image} 
            alt={`${title} screenshot`}
            class="w-full h-64 md:h-96 object-cover rounded-lg shadow-lg"
          />
        </div>
      )}

      <!-- Project content -->
      <article class="prose prose-lg prose-slate dark:prose-invert max-w-none">
        <Content />
      </article>

    </div>
  </main>

  <Footer />
</Layout>
