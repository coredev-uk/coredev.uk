---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

// Linked from the navigation only while there are published posts.
const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime(),
);
---

<Layout title="Writing, Paul Thompson (Core)">
  <Navigation />
  <main id="main-content" class="blog wrap">
    <header class="blog__head">
      <h1 data-reveal>Writing</h1>
      <p data-reveal style="--i: 1">Longer notes on things I have built, and what I learned building them.</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="blog__empty">
          Nothing published yet. The code is on <a class="link" href="https://github.com/coredev-uk">GitHub</a> in the meantime.
        </p>
      ) : (
        <div class="blog__posts">
          {posts.map((post) => (
            <article class="entry">
              <div class="entry__text">
                <h2 data-reveal>
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </h2>
                <p class="entry__desc" data-reveal style="--i: 1">
                  {post.data.description}
                </p>
                <p class="entry__meta" data-reveal style="--i: 2">
                  <time datetime={post.data.publishDate}>
                    {new Date(post.data.publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                </p>
                <p data-reveal style="--i: 3">
                  <a class="link" href={`/blog/${post.slug}`}>
                    Read the post
                  </a>
                </p>
              </div>
              {post.data.image && (
                <a class="entry__picture" href={`/blog/${post.slug}`} tabindex="-1" aria-hidden="true">
                  <img src={post.data.image} alt="" loading="lazy" />
                </a>
              )}
            </article>
          ))}
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .blog {
    padding-top: 9rem;
    padding-bottom: var(--section-gap);
  }

  .blog__head h1 {
    margin: 0;
    font-size: var(--step-display);
    line-height: 1;
  }

  .blog__head p,
  .blog__empty {
    max-width: 40ch;
    margin: 1.5rem 0 0;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .blog__posts {
    display: grid;
    gap: clamp(4rem, 8vw, 6rem);
    margin-top: 4rem;
  }

  .entry {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 1.5rem;
    align-items: center;
  }

  .entry__text {
    grid-column: 1 / span 5;
  }

  .entry__picture {
    grid-column: 7 / -1;
  }

  .entry__picture img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .entry h2 {
    margin: 0 0 0.75rem;
    font-size: var(--step-head);
  }

  .entry h2 a {
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .entry h2 a:hover {
      color: var(--accent);
    }
  }

  .entry__desc {
    margin: 0 0 0.75rem;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .entry__meta {
    margin: 0 0 1.25rem;
    color: var(--muted);
  }

  .entry p {
    margin-bottom: 0.75rem;
  }

  @media (max-width: 640px) {
    .entry__text,
    .entry__picture {
      grid-column: 1 / -1;
    }
  }
</style>
