---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { GITHUB_URL } from '../data/work';

// Linked from the navigation only while there are published posts.
const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime(),
);
---

<Layout title="Writing, Paul Thompson (Core)">
  <Navigation />
  <main id="main-content" class="blog wrap">
    <header class="blog__head">
      <h1 class="display" data-reveal>Writing</h1>
      <p class="lead" data-reveal style="--d: 90ms">Longer notes on things I have built, and what I learned building them.</p>
    </header>

    {
      posts.length === 0 ? (
        <p class="blog__empty lead">
          Nothing published yet. The code is on <a class="text-link" href={GITHUB_URL}>GitHub</a> in the meantime.
        </p>
      ) : (
        <div class="blog__posts section">
          {posts.map((post) => (
            <article class="entry grid12">
              <div class="entry__text">
                <h2>
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="entry__meta">
                  <time datetime={post.data.publishDate}>
                    {new Date(post.data.publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                </p>
                <p class="entry__desc">{post.data.description}</p>
                <p class="actions entry__links">
                  <a class="btn btn--secondary btn--small" href={`/blog/${post.id}`}>
                    Read the post
                  </a>
                </p>
              </div>
              {post.data.image && (
                <a class="window entry__picture" href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true">
                  <span class="window__frame">
                    <img src={post.data.image} alt="" loading="lazy" />
                  </span>
                </a>
              )}
            </article>
          ))}
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<style>
  .blog {
    padding-top: clamp(3rem, 7vw, 6rem);
  }

  .blog__head .lead,
  .blog__empty {
    max-width: 40ch;
    margin: 1.5rem 0 0;
  }

  .blog__posts {
    display: grid;
    gap: clamp(4.5rem, 9vw, 7rem);
  }

  .entry {
    align-items: center;
    row-gap: 1.75rem;
  }

  .entry__text {
    grid-column: 1 / span 5;
  }

  .entry__picture {
    grid-column: 7 / -1;
  }

  .entry__picture .window__frame {
    display: block;
  }

  .entry__picture img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .entry h2 {
    font-size: var(--fs-h2);
  }

  .entry h2 a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    transition: text-decoration-color var(--t-state) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .entry h2 a:hover {
      text-decoration-color: var(--rule);
    }
  }

  .entry__text p {
    margin: 0;
  }

  .entry__text .entry__meta {
    margin-top: 10px;
    color: var(--text2);
    font-size: 0.9375rem;
  }

  .entry__text .entry__desc {
    margin-top: 18px;
    font-size: 1.1875rem;
    line-height: 1.45;
  }

  .entry__text .entry__links {
    margin-top: 24px;
  }

  @media (max-width: 900px) {
    .entry__text,
    .entry__picture {
      grid-column: 1 / -1;
    }
  }
</style>
