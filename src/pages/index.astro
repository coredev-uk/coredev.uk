---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import AboutSkills from '../components/AboutSkills.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import RecentBlog from '../components/RecentBlog.astro';
import ContactSection from '../components/ContactSection.astro';
import { getCollection } from 'astro:content';

// Get featured projects
const projects = await getCollection('projects');
const featuredProjects = projects
.filter(project => project.data.featured)
.slice(0, 3);

// Get recent blog posts
const blogPosts = await getCollection('blog', ({ data}) => {
return data.draft !== true;
});
const recentPosts = blogPosts
.sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
.slice(0, 3);

// Tech stack data
const techStack = [
{
category: "Languages",
icon: "heroicons:code-bracket",
gradient: "from-primary-50/50 to-accent-50/50 dark:from-primary-950/30 dark:to-accent-950/30",
border: "border-primary-200/50 dark:border-primary-800/20",
titleColor: "text-primary-700 dark:text-primary-300",
technologies: [
{ name: "TypeScript", color: "bg-blue-100 border-blue-300 text-blue-800 hover:bg-blue-200 dark:bg-blue-500/20 dark:border-blue-400/30 dark:text-blue-300 dark:hover:bg-blue-500/30" },
{ name: "JavaScript", color: "bg-yellow-100 border-yellow-300 text-yellow-800 hover:bg-yellow-200 dark:bg-yellow-500/20 dark:border-yellow-400/30 dark:text-yellow-300 dark:hover:bg-yellow-500/30" },
{ name: "Java", color: "bg-orange-100 border-orange-300 text-orange-800 hover:bg-orange-200 dark:bg-orange-500/20 dark:border-orange-400/30 dark:text-orange-300 dark:hover:bg-orange-500/30" },
{ name: "PHP", color: "bg-purple-100 border-purple-300 text-purple-800 hover:bg-purple-200 dark:bg-purple-500/20 dark:border-purple-400/30 dark:text-purple-300 dark:hover:bg-purple-500/30" },
{ name: "Python", color: "bg-green-100 border-green-300 text-green-800 hover:bg-green-200 dark:bg-green-500/20 dark:border-green-400/30 dark:text-green-300 dark:hover:bg-green-500/30" },
{ name: "SQL", color: "bg-blue-100 border-blue-400 text-blue-900 hover:bg-blue-200 dark:bg-blue-600/20 dark:border-blue-500/30 dark:text-blue-300 dark:hover:bg-blue-600/30" },
{ name: "Lua", color: "bg-indigo-100 border-indigo-300 text-indigo-800 hover:bg-indigo-200 dark:bg-indigo-500/20 dark:border-indigo-400/30 dark:text-indigo-300 dark:hover:bg-indigo-500/30" },
{ name: "C++", color: "bg-red-100 border-red-300 text-red-800 hover:bg-red-200 dark:bg-red-500/20 dark:border-red-400/30 dark:text-red-300 dark:hover:bg-red-500/30" }
]
},
{
category: "Frameworks & Libraries",
icon: "heroicons:rectangle-stack",
gradient: "from-accent-50/50 to-primary-50/50 dark:from-accent-950/30 dark:to-primary-950/30",
border: "border-accent-200/50 dark:border-accent-800/20",
titleColor: "text-accent-700 dark:text-accent-300",
technologies: [
{ name: "Vue.js", color: "bg-emerald-100 border-emerald-300 text-emerald-800 hover:bg-emerald-200 dark:bg-emerald-500/20 dark:border-emerald-400/30 dark:text-emerald-300 dark:hover:bg-emerald-500/30" },
{ name: "Laravel", color: "bg-red-100 border-red-300 text-red-800 hover:bg-red-200 dark:bg-red-500/20 dark:border-red-400/30 dark:text-red-300 dark:hover:bg-red-500/30" },
{ name: "Electron", color: "bg-cyan-100 border-cyan-300 text-cyan-800 hover:bg-cyan-200 dark:bg-cyan-500/20 dark:border-cyan-400/30 dark:text-cyan-300 dark:hover:bg-cyan-500/30" },
{ name: "Express", color: "bg-green-100 border-green-400 text-green-900 hover:bg-green-200 dark:bg-green-600/20 dark:border-green-500/30 dark:text-green-300 dark:hover:bg-green-600/30" },
{ name: "Koa", color: "bg-slate-100 border-slate-300 text-slate-800 hover:bg-slate-200 dark:bg-slate-500/20 dark:border-slate-400/30 dark:text-slate-300 dark:hover:bg-slate-500/30" },
{ name: "Dexie.js", color: "bg-blue-100 border-blue-300 text-blue-800 hover:bg-blue-200 dark:bg-blue-500/20 dark:border-blue-400/30 dark:text-blue-300 dark:hover:bg-blue-500/30" }
]
},
{
category: "DevOps & Cloud",
icon: "heroicons:cloud-arrow-down",
gradient: "from-gray-100/60 to-slate-100/60 dark:from-gray-900/40 dark:to-slate-900/40",
border: "border-gray-300/50 dark:border-gray-700/30",
titleColor: "text-gray-700 dark:text-gray-300",
technologies: [
{ name: "Docker", color: "bg-blue-100 border-blue-400 text-blue-900 hover:bg-blue-200 dark:bg-blue-600/20 dark:border-blue-500/30 dark:text-blue-300 dark:hover:bg-blue-600/30" },
{ name: "Firebase", color: "bg-yellow-100 border-yellow-400 text-yellow-900 hover:bg-yellow-200 dark:bg-yellow-600/20 dark:border-yellow-500/30 dark:text-yellow-300 dark:hover:bg-yellow-600/30" },
{ name: "Azure Pipelines", color: "bg-blue-100 border-blue-300 text-blue-800 hover:bg-blue-200 dark:bg-blue-500/20 dark:border-blue-400/30 dark:text-blue-300 dark:hover:bg-blue-500/30" },
{ name: "GitHub Actions", color: "bg-gray-100 border-gray-400 text-gray-800 hover:bg-gray-200 dark:bg-gray-700/20 dark:border-gray-600/30 dark:text-gray-300 dark:hover:bg-gray-700/30" }
]
},

];
---

<Layout title="Core - Software Engineer & Full-Stack Developer">
  <Navigation />

  <main id="main-content">
    <Hero />
    <AboutSkills techStack={techStack} />
    <FeaturedProjects projects={featuredProjects} />
    <RecentBlog posts={recentPosts} />
    <ContactSection />
  </main>

  <Footer />
</Layout>
