---
import { workGroups } from '../data/work';

interface Props {
  id?: string;
  heading?: string;
}

const { id = 'projects', heading = 'Projects' } = Astro.props;
---

<section class="lineup wrap section" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`} class="section-title" data-reveal>{heading}</h2>
  <div class="lineup__groups">
    {
      workGroups.map((group, g) => (
        <div class="lineup__group" data-reveal style={`--i: ${g}`}>
          <h3 class="lineup__part">{group.title}</h3>
          <ul class="lineup__rows">
            {group.rows.map((row) => {
              const href = row.slug ? `/projects/${row.slug}` : row.href;
              return (
                <li class="lineup__row">
                  <span class="lineup__name">{href ? <a href={href}>{row.name}</a> : row.name}</span>
                  <span class="lineup__what">{row.what}</span>
                  <span class="lineup__stack">{row.stack}</span>
                  <span class="lineup__years">{row.years}</span>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .lineup__groups {
    display: grid;
    gap: 3rem;
    margin-top: 2.5rem;
  }

  .lineup__part {
    margin: 0 0 0.75rem;
    color: var(--accent);
    font-size: var(--step-body);
    letter-spacing: -0.01em;
  }

  .lineup__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lineup__row {
    position: relative;
    display: grid;
    grid-template-columns: 3fr 4fr 3fr 2fr;
    column-gap: var(--gutter);
    align-items: baseline;
    padding-block: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .lineup__row:nth-child(odd) {
    background: color-mix(in srgb, var(--surface) 60%, transparent);
  }

  .lineup__row > span:first-child {
    padding-left: 0.75rem;
  }

  .lineup__name {
    font-weight: 500;
  }

  .lineup__what,
  .lineup__stack {
    color: var(--muted);
  }

  .lineup__name a {
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }

  .lineup__name a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .lineup__years {
    justify-self: end;
    padding-right: 0.75rem;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .lineup__row:has(a):hover .lineup__name {
      color: var(--accent);
    }
  }

  .lineup__row:has(a:focus-visible) .lineup__name {
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .lineup__row:nth-child(odd) {
      background: none;
    }

    .lineup__row {
      grid-template-columns: 1fr auto;
      row-gap: 0.15rem;
      padding-inline: 0.75rem;
    }

    .lineup__row > span:first-child {
      padding-left: 0;
    }

    .lineup__years {
      padding-right: 0;
    }

    .lineup__what {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .lineup__stack {
      grid-column: 1 / -1;
      grid-row: 3;
      font-size: var(--step-small);
    }
  }
</style>
