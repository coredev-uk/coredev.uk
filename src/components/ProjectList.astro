---
import { workGroups } from '../data/work';

interface Props {
  id?: string;
  heading?: string;
}

const { id = 'projects', heading = 'Projects' } = Astro.props;

// "now" is the one word in the record that is still on, so it takes gilt.
const ongoing = (years: string) => years.endsWith('now');
---

<section class="lineup wrap section" id={id} aria-labelledby={`${id}-title`}>
  <div class="lineup__head">
    <h2 id={`${id}-title`} class="section-title">{heading}</h2>
    <p class="lineup__key"><span class="on">now</span> still running</p>
  </div>
  <div class="lineup__plate plate">
    {
      workGroups.map((group) => (
        <div class="lineup__group">
          <h3 class="label lineup__part">{group.title}</h3>
          <ul>
            {group.rows.map((row) => {
              const href = row.slug ? `/projects/${row.slug}` : row.href;
              return (
                <li class="lrow">
                  <span class="lrow__name">{href ? <a href={href}>{row.name}</a> : row.name}</span>
                  <span class="lrow__what">{row.what}</span>
                  <span class="lrow__stack">{row.stack}</span>
                  <span class="lrow__years">
                    {ongoing(row.years) ? (
                      <>
                        {row.years.slice(0, -3)}
                        <span class="on">now</span>
                      </>
                    ) : (
                      row.years
                    )}
                  </span>
                  {href ? (
                    <svg class="chevron" viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M6 3.5 10.5 8 6 12.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  ) : (
                    <span />
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .lineup__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .lineup__key {
    margin: 0;
    color: var(--text2);
    font-size: var(--fs-label);
  }

  .lineup__plate {
    margin-top: 2rem;
    padding: 6px;
  }

  .lineup__group + .lineup__group {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--rule);
  }

  .lineup__part {
    padding: 14px 12px 8px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A list row: transparent at rest, the hover fill under the pointer, a chevron where it opens something. */
  .lrow {
    position: relative;
    display: grid;
    grid-template-columns: 3fr 4fr 3fr 7rem 16px;
    column-gap: var(--gutter);
    align-items: center;
    min-height: 48px;
    padding: 8px 12px;
    border-radius: var(--r-row);
    font-size: 0.9375rem;
    transition: background-color var(--t-state) var(--ease);
  }

  .lrow__name {
    font-weight: 700;
  }

  .lrow__name a {
    text-decoration: none;
  }

  .lrow__name a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--r-row);
  }

  .lrow__name a:focus-visible {
    outline: none;
  }

  .lrow:has(a:focus-visible) {
    outline: 2px solid var(--gilt);
    outline-offset: -2px;
  }

  .lrow__what,
  .lrow__stack {
    color: var(--text2);
  }

  .lrow__years {
    justify-self: end;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .lrow:has(a):hover {
      background: var(--hover);
    }

    .lrow:has(a):hover .chevron {
      color: var(--text);
    }
  }

  @media (max-width: 900px) {
    .lrow {
      grid-template-columns: minmax(0, 1fr) auto 16px;
      row-gap: 2px;
    }

    .lrow__what {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .lrow__stack {
      grid-column: 1 / -1;
      grid-row: 3;
      font-size: var(--fs-label);
    }
  }
</style>
