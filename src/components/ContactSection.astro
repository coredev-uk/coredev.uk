---
import { Icon } from 'astro-icon/components';
---

<section class="py-32 relative overflow-hidden bg-white dark:bg-dark-900 transition-colors duration-300">
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 animate-fade-in">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-8">
        Get In <span class="text-gradient">Touch</span>
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto leading-relaxed">
        I'm always interested in exciting projects and collaboration opportunities. 
        Feel free to reach out through any of these channels!
      </p>
    </div>

    <!-- Contact Cards -->
    <div class="flex flex-wrap justify-center gap-8 max-w-4xl mx-auto">
      <!-- Email Card -->
      <a 
        href="mailto:core@coredev.uk" 
        class="glass-card p-8 hover:scale-105 transition-all duration-300 group w-full md:w-80 max-w-sm"
      >
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-gradient-to-r from-primary-500 to-accent-500 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <Icon name="heroicons:envelope" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Email</h3>
          <p class="text-primary-600 dark:text-primary-400 font-medium mb-2">core@coredev.uk</p>
          <p class="text-gray-500 dark:text-gray-400 text-sm">Direct and personal communication</p>
        </div>
      </a>

      <!-- LinkedIn Card -->
      <a 
        href="https://linkedin.com/in/-paulthompson/" 
        class="glass-card p-8 hover:scale-105 transition-all duration-300 group w-full md:w-80 max-w-sm"
      >
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-gradient-to-r from-blue-600 to-blue-500 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <Icon name="mdi:linkedin" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">LinkedIn</h3>
          <p class="text-blue-600 dark:text-blue-400 font-medium mb-2">Paul Thompson</p>
          <p class="text-gray-500 dark:text-gray-400 text-sm">Professional networking</p>
        </div>
      </a>

      <!-- X/Twitter Card -->
      <a 
        href="https://x.com/core_hdd" 
        class="glass-card p-8 hover:scale-105 transition-all duration-300 group w-full md:w-80 max-w-sm"
      >
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-gradient-to-r from-gray-800 to-gray-700 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
            <Icon name="simple-icons:x" class="w-8 h-8 text-white" />
          </div>
          <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">X (Twitter)</h3>
          <p class="text-gray-600 dark:text-gray-300 font-medium mb-2">@core_hdd</p>
          <p class="text-gray-500 dark:text-gray-400 text-sm">Quick updates and thoughts</p>
        </div>
      </a>
    </div>
  </div>
</section>
