---
import { EMAIL, GITHUB_URL, LINKEDIN_URL, X_URL } from '../data/work';
---

<section class="contact wrap section" id="contact" aria-labelledby="contact-title">
  <div class="contact__plate plate grid12">
    <div class="contact__intro">
      <h2 id="contact-title" class="section-title">Contact</h2>
      <p>For work, questions about any of my projects or anything else on this site, email is the quickest way to reach me.</p>
    </div>
    <div class="contact__ways">
      <a class="contact__email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <p class="actions">
        <a class="btn btn--secondary btn--small" href={GITHUB_URL} rel="me">GitHub</a>
        <a class="btn btn--secondary btn--small" href={LINKEDIN_URL} rel="me">LinkedIn</a>
        <a class="btn btn--secondary btn--small" href={X_URL} rel="me">X @core_hdd</a>
      </p>
    </div>
  </div>
</section>

<style>
  .contact__plate {
    align-items: end;
    row-gap: 2rem;
    padding: clamp(1.75rem, 4vw, 3.5rem);
  }

  .contact__intro {
    grid-column: 1 / span 5;
  }

  .contact__intro p {
    max-width: 36ch;
    margin: 1rem 0 0;
    color: var(--text2);
  }

  .contact__ways {
    grid-column: 7 / -1;
  }

  .contact__email {
    font-size: var(--fs-h2);
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
    overflow-wrap: anywhere;
    transition: text-decoration-color var(--t-state) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact__email:hover {
      text-decoration-color: var(--text);
    }
  }

  .contact__ways .actions {
    margin-top: 1.25rem;
  }

  @media (max-width: 900px) {
    .contact__intro,
    .contact__ways {
      grid-column: 1 / -1;
    }
  }
</style>
