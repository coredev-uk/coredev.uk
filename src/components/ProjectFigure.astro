---
/**
 * A project's picture: its screenshot when given one. Without an image, nixos and the homelab
 * are shown through their own material: the flake as written, and the cluster's stack.
 */
import { Code } from 'astro:components';
import { meridianCode } from '../styles/meridian-code.mjs';

interface Props {
  slug: string;
  image?: string;
  imageAlt?: string;
}

const { slug, image, imageAlt } = Astro.props;

// nixosConfigurations and darwinConfigurations, as they stand in coredev-uk/nixos/flake.nix.
const flake = `# NixOS configurations
nixosConfigurations = {
  atlas = libx.mkHost {
    hostname = "atlas";
    desktop = "hyprland";
  };
};

# Nix Darwin configurations
darwinConfigurations = {
  poseidon = libx.mkDarwin {
    hostname = "poseidon";
    homeStateVersion = "26.05";
  };
};`;

// From coredev-uk/home-ops: its README and the HelmReleases under kubernetes/apps.
const homelab = [
  ['Nodes', 'Three Talos Linux machines: a Beelink SEi14 and two ThinkCentre Tiny PCs'],
  ['Delivery', 'Flux reconciling the cluster from Git, Renovate keeping charts current'],
  ['Networking', 'Cilium, Envoy Gateway, Cloudflare Tunnel and Pi-hole'],
  ['Storage', 'Rook Ceph across the nodes, CloudNativePG for databases, Kopiur backups'],
  ['Secrets', 'External Secrets backed by 1Password Connect'],
  ['Observability', 'Prometheus, Grafana and VictoriaLogs, with Gatus for uptime'],
  ['Apps', 'Home Assistant, Pocket ID, Outline, Mealie, Atuin and The Lounge'],
  ['Reviews', 'Kritika, an in-cluster AI reviewer guided by a repository skill'],
];
---

{
  image ? (
    <figure class="window pf">
      <div class="window__frame">
        <img src={image} alt={imageAlt ?? ''} loading="lazy" />
      </div>
    </figure>
  ) : slug === 'nixos-configuration' ? (
    <figure class="pf pf--panel">
      <figcaption class="label">flake.nix in coredev-uk/nixos</figcaption>
      <Code code={flake} lang="nix" theme={meridianCode} />
    </figure>
  ) : slug === 'homelab' ? (
    <figure class="pf pf--panel plate">
      <table>
        <caption class="label">The cluster, layer by layer</caption>
        <tbody>
          {homelab.map(([layer, tool]) => (
            <tr>
              <th scope="row">{layer}</th>
              <td>{tool}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </figure>
  ) : null
}

<style>
  .pf {
    margin: 0;
  }

  .pf img {
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 0 0;
  }

  .pf--panel .label {
    margin-bottom: 10px;
  }

  /* The flake as written: Fira Code on the inset, in the Meridian syntax theme. */
  .pf--panel :global(pre) {
    margin: 0;
    padding: 16px 18px;
    border: 1px solid var(--rule);
    border-radius: var(--r-inset);
    font-family: var(--font-code);
    font-feature-settings: normal;
    font-size: clamp(0.8125rem, 0.75rem + 0.2vw, 0.875rem);
    line-height: 1.6;
    overflow-x: auto;
  }

  .plate {
    padding: 6px 16px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  caption {
    padding: 12px 0 8px;
    text-align: left;
  }

  th,
  td {
    padding: 10px 0;
    border-top: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  th {
    width: 36%;
    padding-right: 16px;
    color: var(--text2);
    font-weight: 400;
  }
</style>
