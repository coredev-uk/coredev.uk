---
// One dated entry per row: years on the left, title, place and an optional line beside them, split by rules.
export interface Entry {
  years: string;
  title: string;
  place: string;
  text?: string;
  href?: string;
}

interface Props {
  items: Entry[];
}

const { items } = Astro.props;
---

<ol class="timeline">
  {
    items.map((item) => (
      <li class="timeline__item">
        <p class:list={['timeline__years', { on: item.years === 'Now' }]}>{item.years}</p>
        <div>
          <h4 class="timeline__title">{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h4>
          <p class="timeline__place">{item.place}</p>
          {item.text && <p class="timeline__text">{item.text}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    column-gap: var(--gutter);
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }

  .timeline p {
    margin: 0;
  }

  .timeline__years {
    color: var(--text2);
  }

  .timeline__years.on {
    color: var(--gilt);
  }

  .timeline__title {
    font-size: var(--fs-body);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .timeline__title a {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--t-state) var(--ease);
  }

  @media (hover: hover) and (pointer: fine) {
    .timeline__title a:hover {
      text-decoration-color: var(--text);
    }
  }

  .timeline__place {
    color: var(--text2);
  }

  .timeline .timeline__text {
    margin-top: 6px;
  }

  @media (max-width: 560px) {
    .timeline__item {
      grid-template-columns: 1fr;
      row-gap: 2px;
    }
  }
</style>
