---
// One dated entry per row: years on the left, title, place and an optional line beside them.
export interface Entry {
  years: string;
  title: string;
  place: string;
  text?: string;
  href?: string;
}

interface Props {
  items: Entry[];
  /** Reveal stagger index of the first row, so rows follow their heading. */
  start?: number;
}

const { items, start = 1 } = Astro.props;
---

<ol class="timeline">
  {
    items.map((item, i) => (
      <li class="timeline__item" data-reveal style={`--i: ${start + i}`}>
        <p class="timeline__years">{item.years}</p>
        <div>
          <h4 class="timeline__title">{item.href ? <a href={item.href}>{item.title}</a> : item.title}</h4>
          <p class="timeline__place">{item.place}</p>
          {item.text && <p class="timeline__text">{item.text}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    column-gap: var(--gutter);
  }

  .timeline__years {
    margin: 0;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .timeline__title {
    margin: 0;
    font-size: var(--step-body);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .timeline__title a {
    text-decoration: none;
    transition: color var(--t-hover) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .timeline__title a:hover {
      color: var(--accent);
    }
  }

  .timeline__place {
    margin: 0;
    color: var(--muted);
  }

  .timeline__text {
    margin: 0.35rem 0 0;
  }

  @media (max-width: 560px) {
    .timeline__item {
      grid-template-columns: 1fr;
      row-gap: 0.2rem;
    }
  }
</style>
