---
import { Image } from 'astro:assets';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-b from-white via-slate-50 to-slate-100 dark:from-black dark:via-primary-950/50 dark:to-black"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left Content -->
      <div class="text-left animate-slide-right">
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-6 text-slate-900 dark:text-white">
          Core
        </h1>
        <div class="text-2xl md:text-3xl font-light text-slate-600 dark:text-gray-300 mb-4">
          Software Engineer
        </div>
        <p class="text-lg md:text-xl text-slate-500 dark:text-gray-400 mb-8 leading-relaxed max-w-lg">
          Specialising in <span class="text-primary-600 dark:text-primary-400 font-semibold">Vue.js</span>, 
          <span class="text-accent-600 dark:text-accent-400 font-semibold">TypeScript</span>, 
          <span class="text-primary-600 dark:text-primary-400 font-semibold">Node.js</span>, and 
          <span class="text-accent-600 dark:text-accent-400 font-semibold">DevOps</span>
        </p>

        <!-- Single Action Button -->
        <div class="mb-8">
          <a href="/projects" class="btn-primary group inline-flex items-center whitespace-nowrap">
            <span>View My Work</span>
            <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform duration-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Social Links -->
        <div class="flex space-x-6">
          <a href="https://github.com/coredev-uk" class="social-link" aria-label="GitHub">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href="https://x.com/core_hdd" class="social-link" aria-label="Twitter">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932L18.901 1.153ZM17.61 20.644h2.039L6.486 3.24H4.298L17.61 20.644Z"/>
            </svg>
          </a>
          <a href="mailto:core@coredev.uk" class="social-link" aria-label="Email">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Profile Image -->
      <div class="flex justify-center lg:justify-end animate-slide-left">
        <div class="relative">
          <div class="relative w-64 h-64 md:w-80 md:h-80 rounded-full p-1 bg-gradient-to-r from-primary-500 to-accent-500">
            <Image 
              src="https://avatars.githubusercontent.com/u/64542347?v=4" 
              alt="Core's Profile"
              width={320}
              height={320}
              class="w-full h-full rounded-full object-cover border-2 border-black"
              loading="eager"
              format="webp"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>