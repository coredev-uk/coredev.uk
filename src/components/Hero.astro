---
import { GITHUB_URL, getLatestPush } from '../data/work';

const push = await getLatestPush();
const pushedOn = push
  ? new Date(push.at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero__text">
    <h1 id="hero-title" class="hero__name" data-load style="--d: 80ms">Paul Thompson</h1>
    <p class="hero__lead" data-load style="--d: 160ms">
      Graduate Software Engineer at Lockheed Martin, known online as Core. Before that, four years as a lead on the
      Cider music app.
    </p>
    <p class="hero__push" data-load data-push style="--d: 240ms">
      {
        push ? (
          <>
            Last pushed to <a class="link" href={push.repoUrl}>{push.repo}</a>{' '}
            <time datetime={push.at} data-push-time>on {pushedOn}</time>:{' '}
            <a class="link" href={push.commitUrl}>“{push.message}”</a>
          </>
        ) : (
          <>
            My public work is on <a class="link" href={GITHUB_URL}>GitHub</a>.
          </>
        )
      }
    </p>
    <p class="hero__actions" data-load style="--d: 320ms">
      <a class="button" href={GITHUB_URL} rel="me">View GitHub</a>
      <a class="link" href="#contact">Get in touch</a>
    </p>
  </div>

  <figure class="hero__picture">
    <div class="hero__frame" data-open>
      <img
        src="/work/cider-album.webp"
        width="1440"
        height="894"
        alt="Cider's album view: Chromeo's Adult Contemporary with its artwork, track list and playback bar, tinted red by the cover."
        fetchpriority="high"
      />
    </div>
    <figcaption>Cider's album view, from cider.sh</figcaption>
  </figure>
</section>

<script>
  // The live line: the newest public push, refreshed on every visit.
  const relative = new Intl.RelativeTimeFormat('en-GB', { numeric: 'auto' });
  const units: [Intl.RelativeTimeFormatUnit, number][] = [
    ['year', 31536000],
    ['month', 2592000],
    ['week', 604800],
    ['day', 86400],
    ['hour', 3600],
    ['minute', 60],
  ];

  function ago(iso: string) {
    const seconds = (Date.parse(iso) - Date.now()) / 1000;
    for (const [unit, size] of units) {
      if (Math.abs(seconds) >= size) return relative.format(Math.round(seconds / size), unit);
    }
    return 'just now';
  }

  async function refresh() {
    const line = document.querySelector<HTMLElement>('[data-push]');
    if (!line) return;
    try {
      const events = await fetch('https://api.github.com/users/coredev-uk/events/public?per_page=30');
      if (!events.ok) throw new Error(String(events.status));
      const list: Array<{ type: string; created_at: string; repo: { name: string }; payload: { head?: string } }> =
        await events.json();
      const push = list.find((e) => e.type === 'PushEvent' && e.payload.head);
      if (!push) throw new Error('no push');
      const commit = await fetch(`https://api.github.com/repos/${push.repo.name}/commits/${push.payload.head}`);
      if (!commit.ok) throw new Error(String(commit.status));
      const data: { html_url: string; commit: { message: string } } = await commit.json();

      const repo = document.createElement('a');
      repo.className = 'link';
      repo.href = `https://github.com/${push.repo.name}`;
      repo.textContent = push.repo.name.split('/')[1];
      const time = document.createElement('time');
      time.dateTime = push.created_at;
      time.textContent = ago(push.created_at);
      const message = document.createElement('a');
      message.className = 'link';
      message.href = data.html_url;
      message.textContent = `“${data.commit.message.split('\n')[0]}”`;
      line.replaceChildren('Last pushed to ', repo, ' ', time, ': ', message);
    } catch {
      // Keep the build-time line; only sharpen its date.
      const time = line.querySelector<HTMLTimeElement>('[data-push-time]');
      if (time) time.textContent = ago(time.dateTime);
    }
  }

  document.addEventListener('astro:page-load', refresh);
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
    min-height: min(100svh, 56rem);
    padding-top: 7rem;
    padding-bottom: 3rem;
  }

  .hero__text {
    grid-column: 1 / span 6;
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .hero__name {
    margin: 0;
    font-size: var(--step-display);
    line-height: 1;
  }

  .hero__lead {
    max-width: 34ch;
    margin: 0;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .hero__push {
    max-width: 46ch;
    margin: 0;
    color: var(--muted);
  }

  .hero__push :global(a),
  .hero__push :global(time) {
    color: var(--ink);
  }

  .hero__push :global(a) {
    overflow-wrap: anywhere;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin: 0.5rem 0 0;
  }

  .hero__picture {
    grid-column: 7 / -1;
    margin: 0;
  }

  .hero__frame {
    overflow: clip;
  }

  .hero__picture img {
    width: 100%;
    height: auto;
    background: #121b2b;
  }

  .hero__picture figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: var(--step-small);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero [data-load] {
      opacity: 0;
      transform: translateY(12px);
      animation: hero-rise 600ms var(--ease-out) forwards;
      animation-delay: var(--d);
    }

    :global(.js) .hero [data-open] {
      clip-path: inset(0 0 100% 0);
      animation: hero-open 1000ms var(--ease-in-out) 150ms forwards;
    }

    /* The one moving picture: the screenshot eases closer as the first screen scrolls away. */
    @supports (animation-timeline: view()) {
      .hero__frame img {
        animation: hero-zoom linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes hero-zoom {
    to {
      scale: 1.06;
    }
  }

  @keyframes hero-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-open {
    to {
      clip-path: inset(0);
    }
  }

  @media (max-width: 960px) {
    .hero {
      min-height: 0;
      row-gap: 3rem;
      padding-top: 7rem;
    }

    .hero__text {
      grid-column: 1 / span 10;
    }

    .hero__picture {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 6.5rem;
    }

    .hero__text {
      grid-column: 1 / -1;
    }
  }
</style>
