---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Modern gradient background -->
  <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-white to-slate-100 dark:from-slate-950 dark:via-slate-900 dark:to-slate-800">
    <!-- Subtle overlay patterns for depth -->
    <div class="absolute inset-0 dark:opacity-100 opacity-0">
      <!-- Geometric accent -->
      <div class="absolute top-20 right-20 w-72 h-72 bg-gradient-to-br from-blue-500/5 to-purple-500/5 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 left-20 w-96 h-96 bg-gradient-to-tr from-cyan-500/4 to-blue-500/4 rounded-full blur-3xl"></div>
      <!-- Grid pattern overlay -->
      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-slate-800/5 to-transparent opacity-20" 
           style="background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.05) 1px, transparent 0); background-size: 40px 40px;"></div>
    </div>
  </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left Content -->
      <div class="text-left animate-slide-right">
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-6 bg-gradient-to-r from-slate-900 to-slate-700 dark:from-white dark:to-slate-300 bg-clip-text text-transparent">
          Core
        </h1>
        <div class="text-2xl md:text-3xl font-light text-slate-600 dark:text-slate-300 mb-4">
          Software Engineer
        </div>
        <p class="text-lg md:text-xl text-slate-500 dark:text-slate-400 mb-8 leading-relaxed max-w-lg">
          Specialising in <span class="text-blue-600 dark:text-blue-400 font-semibold">Vue.js</span>, 
          <span class="text-purple-600 dark:text-purple-400 font-semibold">TypeScript</span>, 
          <span class="text-emerald-600 dark:text-emerald-400 font-semibold">Node.js</span>, and 
          <span class="text-cyan-600 dark:text-cyan-400 font-semibold">DevOps</span>
        </p>

        <!-- Modern Action Button -->
        <div class="mb-8">
          <a href="/projects" class="group relative inline-flex items-center px-8 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-semibold rounded-xl hover:scale-105 transform transition-all duration-300 shadow-lg hover:shadow-2xl">
            <span>View My Work</span>
            <Icon name="heroicons:arrow-right" class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform duration-300 flex-shrink-0" />
          </a>
        </div>

        <!-- Modern Social Links -->
        <div class="flex space-x-4">
          <a href="https://github.com/coredev-uk" class="group p-3 bg-sky-200/50 dark:bg-slate-800/50 backdrop-blur-sm rounded-xl hover:bg-sky-300/50 dark:hover:bg-slate-700/50 transition-all duration-300 hover:scale-110" aria-label="GitHub">
            <Icon name="mdi:github" class="w-6 h-6 text-slate-700 dark:text-slate-300" />
          </a>
          <a href="https://x.com/core_hdd" class="group p-3 bg-sky-200/50 dark:bg-slate-800/50 backdrop-blur-sm rounded-xl hover:bg-sky-300/50 dark:hover:bg-slate-700/50 transition-all duration-300 hover:scale-110" aria-label="Twitter">
            <Icon name="simple-icons:x" class="w-6 h-6 text-slate-700 dark:text-slate-300" />
          </a>
          <a href="mailto:core@coredev.uk" class="group p-3 bg-sky-200/50 dark:bg-slate-800/50 backdrop-blur-sm rounded-xl hover:bg-sky-300/50 dark:hover:bg-slate-700/50 transition-all duration-300 hover:scale-110" aria-label="Email">
            <Icon name="heroicons:envelope" class="w-6 h-6 text-slate-700 dark:text-slate-300" />
          </a>
        </div>
      </div>

      <!-- Right Profile Image -->
      <div class="flex justify-center lg:justify-end animate-slide-left">
        <div class="relative">
          <div class="relative w-64 h-64 md:w-80 md:h-80 rounded-2xl p-1 bg-gradient-to-br from-blue-500/20 to-purple-500/20 backdrop-blur-sm">
            <Image 
              src="https://avatars.githubusercontent.com/u/64542347?v=4" 
              alt="Core's Profile"
              width={320}
              height={320}
              class="w-full h-full rounded-2xl object-cover border border-white/10 dark:border-slate-700/50"
              loading="eager"
              format="webp"
            />
          </div>
          <!-- Floating accent -->
          <div class="absolute -top-4 -right-4 w-8 h-8 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full opacity-80 animate-pulse"></div>
        </div>
      </div>
    </div>
  </div>
</section>
