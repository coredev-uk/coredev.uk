---
import { GITHUB_URL, getLatestPush } from '../data/work';

const push = await getLatestPush();
const pushedOn = push
  ? new Date(push.at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : null;
---

<section class="hero grid12 wrap" aria-labelledby="hero-title">
  <div class="hero__id">
    <h1 id="hero-title" class="hero__name" data-reveal><span>Paul</span> <span>Thompson</span></h1>
    <p class="hero__lead lead" data-reveal style="--d: 90ms">
      Graduate Software Engineer at Lockheed Martin, known online as Core. Before that, four years as a lead on the
      Cider music app.
    </p>
    <p class="actions hero__actions" data-reveal style="--d: 180ms">
      <a class="btn btn--primary" href={GITHUB_URL} rel="me">View GitHub</a>
      <a class="btn btn--secondary" href="#contact">Get in touch</a>
    </p>
    <p class="hero__push" data-reveal data-push style="--d: 270ms">
      {
        push ? (
          <>
            Last pushed to <a class="text-link" href={push.repoUrl}>{push.repo}</a>{' '}
            <time datetime={push.at} data-push-time>on {pushedOn}</time>:{' '}
            <a class="text-link" href={push.commitUrl}>“{push.message}”</a>
          </>
        ) : (
          <>
            My public work is on <a class="text-link" href={GITHUB_URL}>GitHub</a>.
          </>
        )
      }
    </p>
  </div>

  <figure class="window window--float hero__window" data-reveal="settle" style="--d: 120ms">
    <div class="window__frame">
      <img
        src="/work/cider-album.webp"
        width="1440"
        height="894"
        alt="Cider's album view: Chromeo's Adult Contemporary with its artwork, track list and playback bar, tinted red by the cover."
        fetchpriority="high"
      />
    </div>
    <figcaption>Cider's album view, from cider.sh</figcaption>
  </figure>
</section>

<script>
  // The live line: the newest public push, asked of GitHub at most once every ten minutes per browser.
  const relative = new Intl.RelativeTimeFormat('en-GB', { numeric: 'auto' });
  const units: [Intl.RelativeTimeFormatUnit, number][] = [
    ['year', 31536000],
    ['month', 2592000],
    ['week', 604800],
    ['day', 86400],
    ['hour', 3600],
    ['minute', 60],
  ];

  function ago(iso: string) {
    const seconds = (Date.parse(iso) - Date.now()) / 1000;
    for (const [unit, size] of units) {
      if (Math.abs(seconds) >= size) return relative.format(Math.round(seconds / size), unit);
    }
    return 'just now';
  }

  type Push = { repo: string; at: string; message: string; commitUrl: string };
  type Cached = Push & { fetchedAt: number };

  const CACHE_KEY = 'coredev:last-push';
  const CACHE_MS = 10 * 60 * 1000;

  // Storage can be missing or refuse writes (private windows, blocked cookies); the line then just fetches.
  function readCache(): Cached | null {
    try {
      const raw = localStorage.getItem(CACHE_KEY);
      return raw ? (JSON.parse(raw) as Cached) : null;
    } catch {
      return null;
    }
  }

  async function fetchPush(): Promise<Push> {
    const events = await fetch('https://api.github.com/users/coredev-uk/events/public?per_page=30');
    if (!events.ok) throw new Error(String(events.status));
    const list: Array<{ type: string; created_at: string; repo: { name: string }; payload: { head?: string } }> =
      await events.json();
    const push = list.find((e) => e.type === 'PushEvent' && e.payload.head);
    if (!push) throw new Error('no push');
    const commit = await fetch(`https://api.github.com/repos/${push.repo.name}/commits/${push.payload.head}`);
    if (!commit.ok) throw new Error(String(commit.status));
    const data: { html_url: string; commit: { message: string } } = await commit.json();
    return { repo: push.repo.name, at: push.created_at, message: data.commit.message.split('\n')[0], commitUrl: data.html_url };
  }

  function render(line: HTMLElement, push: Push) {
    const repo = document.createElement('a');
    repo.className = 'text-link';
    repo.href = `https://github.com/${push.repo}`;
    repo.textContent = push.repo.split('/')[1];
    const time = document.createElement('time');
    time.dateTime = push.at;
    time.textContent = ago(push.at);
    const message = document.createElement('a');
    message.className = 'text-link';
    message.href = push.commitUrl;
    message.textContent = `“${push.message}”`;
    line.replaceChildren('Last pushed to ', repo, ' ', time, ': ', message);
  }

  async function refresh() {
    const line = document.querySelector<HTMLElement>('[data-push]');
    if (!line) return;
    const cached = readCache();
    if (cached && Date.now() - cached.fetchedAt < CACHE_MS) {
      render(line, cached);
      return;
    }
    try {
      const push = await fetchPush();
      render(line, push);
      try {
        localStorage.setItem(CACHE_KEY, JSON.stringify({ ...push, fetchedAt: Date.now() } satisfies Cached));
      } catch {
        // Not cached this time; the next visit asks GitHub again.
      }
    } catch {
      // GitHub didn't answer: show the last answer this browser saw, else keep the build-time line.
      if (cached) {
        render(line, cached);
      } else {
        const time = line.querySelector<HTMLTimeElement>('[data-push-time]');
        if (time) time.textContent = ago(time.dateTime);
      }
    }
  }

  document.addEventListener('astro:page-load', refresh);
</script>

<style>
  /* The Window register: the name in Light at display scale, the Cider window floating beside it. */
  .hero {
    align-items: center;
    row-gap: 3rem;
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(1rem, 3vw, 2rem);
  }

  .hero__id {
    grid-column: 1 / span 6;
  }

  .hero__name {
    margin-left: -0.045em;
    font-size: var(--fs-display);
    font-weight: 300;
    letter-spacing: -0.03em;
    line-height: 0.92;
  }

  .hero__name span {
    display: block;
  }

  .hero__lead {
    max-width: 31ch;
    margin: clamp(1.5rem, 3vw, 2.25rem) 0 0;
  }

  .hero__actions {
    margin-top: 2rem;
  }

  /* The record line: the latest public push, set on a rule under the actions. */
  .hero__push {
    max-width: 46ch;
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    color: var(--text2);
    font-size: 0.9375rem;
  }

  .hero__push :global(time) {
    color: var(--text);
  }

  .hero__push :global(a) {
    overflow-wrap: anywhere;
  }

  .hero__window {
    grid-column: 7 / -1;
  }

  @media (max-width: 900px) {
    .hero__id,
    .hero__window {
      grid-column: 1 / -1;
    }
  }
</style>
