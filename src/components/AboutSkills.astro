---
export interface TechStack {
  category: string;
  icon: string;
  gradient: string;
  border: string;
  titleColor: string;
  technologies: Array<{
    name: string;
    color: string;
  }>;
}

interface Props {
  techStack: TechStack[];
}

const { techStack } = Astro.props;
---

<section class="py-32 relative overflow-hidden bg-gray-50 dark:bg-black transition-colors duration-300">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-primary-50/30 to-transparent dark:bg-gradient-to-b dark:from-black dark:via-primary-950/50 dark:to-black"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="animate-slide-right">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-8">
          About <span class="text-gradient">Me</span>
        </h2>
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-6 leading-relaxed">
          I'm a passionate software engineer specialising in modern web technologies and DevOps practices. 
          With experience in building scalable applications and contributing to notable open source projects 
          like <span class="text-primary-600 dark:text-primary-400 font-semibold">Cider</span> (Apple Music Electron apps).
        </p>
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-8 leading-relaxed">
          My expertise spans from front-end frameworks like Vue.js and TypeScript to backend systems 
          with Node.js, plus infrastructure management using NixOS and Kubernetes.
        </p>
        <a href="https://github.com/coredev-uk" class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-semibold text-lg group transition-colors duration-300">
          <span>Explore My GitHub</span>
          <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>

      <div class="animate-slide-left">
        <div class="glass-card p-8">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-8">Tech Stack</h3>
          <div class="space-y-6">
            {techStack.map((section) => (
            <div class={`bg-gradient-to-r ${section.gradient} rounded-xl p-6 border ${section.border}`}>
              <h4 class={`text-lg font-semibold ${section.titleColor} mb-4 flex items-center`}>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={section.icon}/>
                </svg>
                {section.category}
              </h4>
              <div class="flex flex-wrap gap-2">
                {section.technologies.map((tech) => (
                <span class={`px-3 py-1.5 border ${tech.color} rounded-lg text-sm font-medium transition-colors`}>
                  {tech.name}
                </span>
                ))}
              </div>
            </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>