---
import { getCollection } from 'astro:content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hasPosts = (await getCollection('blog', ({ data }) => data.draft !== true)).length > 0;

// The shell's bar: pages sit like workspace numerals, home first. Contact is the one action on the right.
const links = [
  { href: '/', label: 'Paul Thompson' },
  { href: '/projects', label: 'Projects' },
  ...(hasPosts ? [{ href: '/blog', label: 'Writing' }] : []),
];

const current = (href: string) =>
  path === href ? 'page' : href !== '/' && path.startsWith(`${href}/`) ? 'true' : undefined;
---

<header class="bar" transition:name="bar" transition:animate="none">
  <div class="bar__inner wrap">
    <nav aria-label="Main" class="bar__nav">
      <ul class="ws">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="bar__action" href="/#contact">Contact</a>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--bar-h);
    border-bottom: 1px solid var(--rule);
    background: var(--ground);
    font-size: var(--fs-small);
  }

  .bar__inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    height: 100%;
  }

  .bar__nav {
    display: flex;
  }

  .ws {
    display: flex;
    align-items: stretch;
    margin: 0 0 0 -10px;
    padding: 0;
    list-style: none;
  }

  .ws a,
  .bar__action {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 10px;
    color: var(--text2);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--t-state) var(--ease);
  }

  /* "Here": the current page is gilt and bold over a 14×2 rule on the bar's inner edge. */
  .ws a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -1px;
    width: 14px;
    height: 2px;
    translate: -50% 0;
    background: transparent;
    transition: background-color var(--t-state) var(--ease);
  }

  .ws a[aria-current] {
    color: var(--gilt);
    font-weight: 700;
  }

  .ws a[aria-current]::after {
    background: var(--gilt);
  }

  .bar__action {
    margin-right: -10px;
    color: var(--text);
  }

  @media (hover: hover) and (pointer: fine) {
    .ws a:hover,
    .bar__action:hover {
      color: var(--text);
    }

    .ws a[aria-current]:hover {
      color: var(--gilt-hover);
    }
  }

  @media (max-width: 420px) {
    .ws a,
    .bar__action {
      padding-inline: 8px;
    }

    .ws {
      margin-left: -8px;
    }

    .bar__action {
      margin-right: -8px;
    }
  }
</style>
