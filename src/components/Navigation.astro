---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 w-full z-50 bg-white/80 dark:bg-slate-900/80 border-b border-slate-200 dark:border-slate-700/20 backdrop-blur-lg">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex items-center">
        <a href="/" class="text-2xl font-bold gradient-text hover:scale-105 transition-transform duration-300">
          Core
        </a>
      </div>
      
      <div class="hidden md:flex items-center space-x-1">
        <div class="flex items-center space-x-1">
          <a 
            href="/" 
            class={`nav-link ${
              currentPath === '/' 
                ? 'text-primary-600 dark:text-primary-300 active' 
                : 'text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-300'
            }`}
          >
            <span>Home</span>
          </a>
          <a 
            href="/projects" 
            class={`nav-link ${
              currentPath === '/projects' 
                ? 'text-primary-600 dark:text-primary-300 active' 
                : 'text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-300'
            }`}
          >
            <span>Projects</span>
          </a>
          <a 
            href="/blog" 
            class={`nav-link ${
              currentPath === '/blog' 
                ? 'text-primary-600 dark:text-primary-300 active' 
                : 'text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-300'
            }`}
          >
            <span>Blog</span>
          </a>
        </div>

        <!-- GitHub Link & Theme Toggle -->
        <div class="ml-6 flex items-center space-x-2">
          <ThemeToggle />
          <a 
            href="https://github.com/coredev-uk" 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-2 text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-300 hover:bg-slate-100 dark:hover:bg-slate-800/30 rounded-lg transition-all duration-300 group"
            aria-label="GitHub Profile"
          >
            <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button 
          id="mobile-menu-button"
          type="button" 
          class="bg-slate-100 dark:bg-slate-800/50 rounded-lg p-2 inline-flex items-center justify-center text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-300 hover:bg-slate-200 dark:hover:bg-slate-800/50 focus:outline-none focus:ring-2 focus:ring-primary-500 transition-all duration-300"
        >
          <span class="sr-only">Open main menu</span>
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="md:hidden hidden">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-white/95 dark:bg-slate-900/95 border-t border-slate-200 dark:border-slate-700/20 backdrop-blur-lg">
      <a href="/" class="text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-300 block px-3 py-2 rounded-md text-base font-medium transition-colors duration-300">Home</a>
      <a href="/projects" class="text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-300 block px-3 py-2 rounded-md text-base font-medium transition-colors duration-300">Projects</a>
      <a href="/blog" class="text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-300 block px-3 py-2 rounded-md text-base font-medium transition-colors duration-300">Blog</a>
      <a href="/cv.pdf" target="_blank" rel="noopener noreferrer" class="text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-300 block px-3 py-2 rounded-md text-base font-medium transition-colors duration-300">CV</a>
      <div class="border-t border-slate-200 dark:border-slate-700/20 pt-2 mt-2 flex items-center justify-between">
        <a href="https://github.com/coredev-uk" target="_blank" rel="noopener noreferrer" class="text-slate-600 dark:text-slate-300 hover:text-primary-600 dark:hover:text-primary-300 block px-3 py-2 rounded-md text-base font-medium transition-colors duration-300 flex items-center">
          <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.30.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <div class="px-3">
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
      });
    }
  });
</script>