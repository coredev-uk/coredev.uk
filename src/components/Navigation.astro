---
import { getCollection } from 'astro:content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hasPosts = (await getCollection('blog', ({ data }) => data.draft !== true)).length > 0;

// Only pages. Home is the wordmark; its sections are reached by scrolling it, external profiles live in Contact and the footer.
const links = [
  { href: '/projects', label: 'Projects' },
  ...(hasPosts ? [{ href: '/blog', label: 'Writing' }] : []),
];

const current = (href: string) => (path === href ? 'page' : path.startsWith(`${href}/`) ? 'true' : undefined);
---

<header class="nav">
  <div class="nav__inner wrap">
    <a class="nav__mark" href="/" aria-current={path === '/' ? 'page' : undefined}>Paul Thompson</a>
    <nav aria-label="Main" class="nav__bar">
      <ul class="nav__links">
        {
          links.map((link) => (
            <li>
              <a class="link nav__link" href={link.href} aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="link nav__link nav__action" href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    font-size: var(--step-small);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 1.5rem;
  }

  .nav__mark {
    font-weight: 500;
    text-decoration: none;
  }

  .nav__bar,
  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.4vw, 2rem);
  }

  .nav__links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__link {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--muted);
    text-decoration-color: transparent;
  }

  .nav__link[aria-current] {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  .nav__action {
    color: var(--accent);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav__link:hover {
      color: var(--ink);
    }

    .nav__action:hover {
      color: var(--accent-strong);
    }
  }

  @media (max-width: 480px) {
    .nav__bar,
    .nav__links {
      gap: 1rem;
    }
  }
</style>
