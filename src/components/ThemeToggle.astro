---
import { Icon } from 'astro-icon/components';
---

<button 
  class="theme-toggle p-2 text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-300 hover:bg-slate-100 dark:hover:bg-slate-800/30 rounded-lg transition-all duration-200 group active:scale-95"
  type="button"
  aria-label="Toggle theme"
>
  <!-- Sun icon (visible in dark mode) -->
  <Icon 
    name="heroicons:sun" 
    class="theme-sun-icon w-5 h-5 group-hover:scale-110 transition-all duration-200 hidden dark:block group-active:rotate-180" 
  />
  
  <!-- Moon icon (visible in light mode) -->
  <Icon 
    name="heroicons:moon" 
    class="theme-moon-icon w-5 h-5 group-hover:scale-110 transition-all duration-200 block dark:hidden group-active:-rotate-12" 
  />
</button>

<script is:inline>
  // Theme utilities
  function getStoredTheme() {
    try {
      return localStorage.getItem('theme');
    } catch (e) {
      return null;
    }
  }

  function getSystemTheme() {
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function getCurrentTheme() {
    return getStoredTheme() || getSystemTheme();
  }

  function setTheme(theme, doc = document) {
    // Apply theme to document element
    if (theme === 'dark') {
      doc.documentElement.classList.add('dark');
      doc.documentElement.style.colorScheme = 'dark';
    } else {
      doc.documentElement.classList.remove('dark');
      doc.documentElement.style.colorScheme = 'light';
    }

    // Store preference
    try {
      localStorage.setItem('theme', theme);
    } catch (e) {
      // Handle localStorage errors silently
    }
  }

  function toggleTheme() {
    const currentTheme = getCurrentTheme();
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    setTheme(newTheme);

    // Add visual feedback to all toggle buttons
    const buttons = document.querySelectorAll('.theme-toggle');
    buttons.forEach(button => {
      button.style.transform = 'scale(0.95)';
      setTimeout(() => {
        button.style.transform = '';
      }, 150);
    });
  }

  function initTheme() {
    // Set initial theme
    const theme = getCurrentTheme();
    setTheme(theme);

    // Bind theme toggle buttons
    const themeToggles = document.querySelectorAll('.theme-toggle');
    themeToggles.forEach(toggle => {
      toggle.addEventListener('click', toggleTheme);
    });

    // Listen for system theme changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      // Only auto-update if user hasn't manually set a preference
      if (!getStoredTheme()) {
        setTheme(e.matches ? 'dark' : 'light');
      }
    });
  }

  // Initialize theme immediately to prevent FOUC
  if (document.readyState === 'loading') {
    // Set theme immediately if document is still loading
    const theme = getCurrentTheme();
    setTheme(theme);
    document.addEventListener('DOMContentLoaded', initTheme);
  } else {
    // Document already loaded
    initTheme();
  }

  // Handle view transitions - ensure theme persists across page navigation
  document.addEventListener('astro:before-swap', (event) => {
    // Apply current theme to the new document before swap
    const currentTheme = getCurrentTheme();
    setTheme(currentTheme, event.newDocument);
  });

  // Re-initialize after page navigation
  document.addEventListener('astro:page-load', initTheme);
</script>