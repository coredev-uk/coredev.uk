---
import type { CollectionEntry } from 'astro:content';
import { getStatusClasses } from '../utils/projectStatus';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="py-32 relative overflow-hidden bg-white dark:bg-black transition-colors duration-300">
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-blue-50/30 to-transparent dark:bg-gradient-to-b dark:from-black dark:via-primary-950/30 dark:to-black"></div>
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16 animate-fade-in">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6">
        Featured <span class="text-gradient">Projects</span>
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        A showcase of my recent work, from open source contributions to personal projects.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-8 mb-16 max-w-7xl mx-auto">
      {projects.map((project, index) => (
      <div class={`project-card animate-slide-up-${index + 1} w-full md:w-80 lg:w-96 max-w-sm`}>
        <div class="project-image-placeholder">
          <div class="text-white text-xl font-bold text-center px-4">{project.data.title}</div>
        </div>
        <div class="p-6">
          <div class="flex items-start justify-between mb-3">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">{project.data.title}</h3>
            {project.data.status && (
              <span class={`capitalize px-2 py-1 rounded-full text-xs font-semibold ml-2 flex-shrink-0 ${
                getStatusClasses(project.data.status)
              }`}>
                {project.data.status}
              </span>
            )}
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-4 text-sm leading-relaxed">{project.data.description}</p>
          <div class="flex flex-wrap gap-2 mb-6">
            {project.data.technologies?.slice(0, 3).map((tech: string) => (
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gradient-to-r from-primary-100 to-accent-100 border border-primary-200 text-primary-700 hover:from-primary-200 hover:to-accent-200 hover:border-primary-300 hover:text-primary-800 dark:from-primary-600/20 dark:to-accent-600/20 dark:border-primary-500/30 dark:text-primary-300 dark:hover:from-primary-500/30 dark:hover:to-accent-500/30 dark:hover:border-primary-400/50 dark:hover:text-primary-200 transition-all duration-300 hover:scale-105">
              {tech}
            </span>
            ))}
          </div>
          <a 
            href={`/projects/${project.slug}`}
            class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-semibold text-sm group transition-colors duration-300"
          >
            <span>Learn More</span>
            <svg class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
      ))}
    </div>

    <div class="text-center">
      <a href="/projects" class="btn-primary group inline-flex items-center whitespace-nowrap">
        <span>View All Projects</span>
        <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform duration-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>