---
import { GITHUB_URL, LINKEDIN_URL } from '../data/work';
import Timeline, { type Entry } from './Timeline.astro';

const experience: Entry[] = [
  {
    years: 'Now',
    title: 'Graduate Software Engineer',
    place: 'Lockheed Martin',
  },
  {
    years: '2021–2025',
    title: 'Core Maintainer',
    place: 'Apple-Music-Electron and Cider',
    text: 'From first contributor to one of three core maintainers, owning releases and the macOS and Linux client.',
    href: '/projects/cider',
  },
  {
    years: '2016–2020',
    title: 'Server Developer',
    place: 'Garry’s Mod communities',
    text: 'Where I learned to program, building and running Lua game servers.',
  },
];

// One degree and a few certifications. Both read like Experience: years first, newest first.
const education: Entry[] = [
  { years: '2022–2025', title: 'BSc Software Engineering', place: 'University of Kent', text: 'First Class Honours' },
];

const certifications: Entry[] = [
  { years: '2026', title: 'AWS Certified Cloud Practitioner', place: 'Amazon Web Services' },
  { years: '2021', title: 'Azure AI Fundamentals (AI-900)', place: 'Microsoft' },
];

const tools = [
  { group: 'Languages', items: 'TypeScript, JavaScript, Java, C++, Python, PHP, SQL, Lua, Nix' },
  { group: 'Apps and frameworks', items: 'Vue, Electron, Node.js, Fastify, Laravel, Express, Dexie.js' },
  { group: 'Infrastructure', items: 'Docker, Kubernetes, Talos Linux, Flux, Helm, Cilium, Rook Ceph, AWS, Cloudflare' },
  { group: 'Delivery', items: 'GitHub Actions, Azure Pipelines, CircleCI, Renovate, AI coding agents' },
];
---

<section class="about wrap section field" id="about" aria-labelledby="about-title">
  <div class="about__main">
    <div class="about__intro">
      <h2 id="about-title" class="section-title" data-reveal>About</h2>
      <p class="about__lead" data-reveal style="--i: 1">
        I build desktop software and the infrastructure it ships on. These days most of my own time goes on my NixOS setup and my homelab.
      </p>
      <p class="about__links" data-reveal style="--i: 2">
        <a class="link" href={GITHUB_URL} rel="me">GitHub</a>
        <a class="link" href={LINKEDIN_URL} rel="me">LinkedIn</a>
      </p>

      <h3 class="about__label" data-reveal style="--i: 3">Education</h3>
      <Timeline items={education} start={4} />
    </div>

    <div class="about__record">
      <h3 class="about__label" data-reveal>Experience</h3>
      <Timeline items={experience} />

      <h3 class="about__label" data-reveal style={`--i: ${experience.length + 1}`}>Certifications</h3>
      <Timeline items={certifications} start={experience.length + 2} />
    </div>
  </div>

  <div class="about__tools">
    <h3 class="about__label" data-reveal>Tools</h3>
    <dl class="tools">
      {
        tools.map((tool, i) => (
          <div data-reveal style={`--i: ${i + 1}`}>
            <dt>{tool.group}</dt>
            <dd>{tool.items}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  /*
   * Fixed on the left: intro and the one degree. The lists that grow (experience, certifications) share the right column,
   * and the left column stays in view beside them on wide screens, so a longer right column never leaves a gap.
   * Both columns sit in .about__main, which bounds the sticky intro so it never rides over Tools below.
   */
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: clamp(3rem, 5vw, 4rem);
    align-items: start;
  }

  .about__main {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: clamp(3rem, 5vw, 4rem);
    align-items: start;
  }

  .about__intro {
    grid-column: 1 / span 5;
  }

  .about__record {
    grid-column: 7 / -1;
  }

  .about__tools {
    grid-column: 1 / -1;
  }

  .about__lead {
    max-width: 34ch;
    margin: 1.25rem 0 0;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .about__links {
    display: flex;
    gap: 1.5rem;
    margin: 1.25rem 0 0;
  }

  .about__label {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font-size: var(--step-body);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .about__label:not(:first-child) {
    margin-top: 3rem;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem var(--gutter);
    margin: 0;
  }

  .tools dt {
    margin-bottom: 0.35rem;
    color: var(--muted);
  }

  .tools dd {
    margin: 0;
  }

  @media (max-width: 960px) {
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 861px) {
    .about__intro {
      position: sticky;
      top: var(--margin);
    }
  }

  @media (max-width: 860px) {
    .about__intro,
    .about__record {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .tools {
      grid-template-columns: 1fr;
    }
  }
</style>
