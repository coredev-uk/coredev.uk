---
import { GITHUB_URL, LINKEDIN_URL } from '../data/work';
import Timeline, { type Entry } from './Timeline.astro';

const experience: Entry[] = [
  {
    years: 'Now',
    title: 'Graduate Software Engineer',
    place: 'Lockheed Martin',
  },
  {
    years: '2021–2025',
    title: 'Core Maintainer',
    place: 'Apple-Music-Electron and Cider',
    text: 'From first contributor to one of three core maintainers, owning releases and the macOS and Linux client.',
    href: '/projects/cider',
  },
  {
    years: '2016–2020',
    title: 'Server Developer',
    place: 'Garry’s Mod communities',
    text: 'Where I learned to program, building and running Lua game servers.',
  },
];

// One degree and a few certifications. Both read like Experience: years first, newest first.
const education: Entry[] = [
  { years: '2022–2025', title: 'BSc Software Engineering', place: 'University of Kent', text: 'First Class Honours' },
];

const certifications: Entry[] = [
  { years: '2026', title: 'AWS Certified Cloud Practitioner', place: 'Amazon Web Services' },
  { years: '2021', title: 'Azure AI Fundamentals (AI-900)', place: 'Microsoft' },
];

const tools = [
  { group: 'Languages', items: 'TypeScript, JavaScript, Java, C++, Python, PHP, SQL, Lua, Nix' },
  { group: 'Apps and frameworks', items: 'Vue, Electron, Node.js, Fastify, Laravel, Express, Dexie.js' },
  { group: 'Infrastructure', items: 'Docker, Kubernetes, Talos Linux, Flux, Helm, Cilium, Rook Ceph, AWS, Cloudflare' },
  { group: 'Delivery', items: 'GitHub Actions, Azure Pipelines, CircleCI, Renovate, AI coding agents' },
];
---

<section class="about wrap section" id="about" aria-labelledby="about-title">
  <div class="about__main grid12">
    <div class="about__intro">
      <h2 id="about-title" class="section-title">About</h2>
      <p class="about__lead lead">
        I build desktop software and the infrastructure it ships on. These days most of my own time goes on my NixOS setup and my homelab.
      </p>
      <p class="actions about__links">
        <a class="btn btn--secondary btn--small" href={GITHUB_URL} rel="me">GitHub</a>
        <a class="btn btn--secondary btn--small" href={LINKEDIN_URL} rel="me">LinkedIn</a>
      </p>

      <h3 class="label about__label">Education</h3>
      <Timeline items={education} />
    </div>

    <div class="about__record">
      <h3 class="label about__label">Experience</h3>
      <Timeline items={experience} />

      <h3 class="label about__label">Certifications</h3>
      <Timeline items={certifications} />
    </div>
  </div>

  <dl class="tools plate" aria-label="Tools">
    {
      tools.map((tool) => (
        <div>
          <dt class="label">{tool.group}</dt>
          <dd>{tool.items}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /*
   * Fixed on the left: intro and the one degree. The lists that grow (experience, certifications) share the right column,
   * and the left column stays in view beside them on wide screens. Both sit in .about__main, which bounds the sticky
   * intro so it never rides over Tools below.
   */
  .about__main {
    align-items: start;
    row-gap: 3rem;
  }

  .about__intro {
    grid-column: 1 / span 5;
  }

  .about__record {
    grid-column: 7 / -1;
  }

  .about__lead {
    max-width: 32ch;
    margin: 1.25rem 0 0;
  }

  .about__links {
    margin-top: 1.5rem;
  }

  .about__label {
    margin-bottom: 6px;
  }

  .about__intro .about__label {
    margin-top: 3rem;
  }

  .about__record .about__label ~ .about__label {
    margin-top: 2.5rem;
  }

  .tools {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem var(--gutter);
    margin: clamp(3rem, 5vw, 4rem) 0 0;
    padding: 20px 24px;
  }

  .tools dt {
    margin-bottom: 6px;
  }

  .tools dd {
    margin: 0;
  }

  @media (min-width: 901px) {
    .about__intro {
      position: sticky;
      top: calc(var(--bar-h) + 24px);
    }
  }

  @media (max-width: 1100px) {
    .tools {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .about__intro,
    .about__record {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .tools {
      grid-template-columns: 1fr;
    }
  }
</style>
