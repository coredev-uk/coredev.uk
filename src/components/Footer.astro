---
import { getCollection } from 'astro:content';
import { WORKERS_CI_COMMIT_SHA as COMMIT_SHA } from 'astro:env/client';
import { EMAIL, GITHUB_URL, LINKEDIN_URL, X_URL } from '../data/work';

const hasPosts = (await getCollection('blog', ({ data }) => data.draft !== true)).length > 0;
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__cols">
      <ul>
        <li>Paul Thompson</li>
        <li>Graduate Software Engineer</li>
        <li>Known online as Core</li>
      </ul>
      <ul>
        <li>Pages</li>
        <li><a class="quiet-link" href="/#work">Work</a></li>
        <li><a class="quiet-link" href="/projects">Projects</a></li>
        {hasPosts && <li><a class="quiet-link" href="/blog">Writing</a></li>}
        <li><a class="quiet-link" href="/#about">About</a></li>
        <li><a class="quiet-link" href="/#contact">Contact</a></li>
      </ul>
      <ul>
        <li>Elsewhere</li>
        <li><a class="quiet-link" href={GITHUB_URL} rel="me">GitHub</a></li>
        <li><a class="quiet-link" href={LINKEDIN_URL} rel="me">LinkedIn</a></li>
        <li><a class="quiet-link" href={X_URL} rel="me">X @core_hdd</a></li>
        <li><a class="quiet-link" href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
      </ul>
      <ul>
        <li>This site</li>
        <li>Astro on Cloudflare Workers</li>
        {
          COMMIT_SHA !== 'unset' && (
            <li>
              Built from{' '}
              <a class="quiet-link footer__sha" href={`https://github.com/coredev-uk/coredev.uk/commit/${COMMIT_SHA}`}>
                {COMMIT_SHA.substring(0, 7)}
              </a>
            </li>
          )
        }
        <li>Cider screenshots from the Cider Collective’s public repositories</li>
      </ul>
    </div>
    <p class="footer__legal">© {new Date().getFullYear()} Paul Thompson. Content licensed CC BY-NC-SA 4.0.</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    padding-block: 3.5rem 2rem;
    border-top: 1px solid var(--rule);
    color: var(--text2);
    font-size: var(--fs-small);
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem var(--gutter);
  }

  .footer ul {
    display: grid;
    align-content: start;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer li:first-child {
    margin-bottom: 4px;
    color: var(--text);
    font-weight: 700;
  }

  .footer__sha {
    color: var(--text);
  }

  .footer__legal {
    margin: 3.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  @media (max-width: 760px) {
    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
