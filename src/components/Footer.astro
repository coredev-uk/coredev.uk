---
import { Icon } from 'astro-icon/components';
import { WORKERS_CI_COMMIT_SHA as COMMIT_SHA } from 'astro:env/client'
---

<footer class="bg-gray-100 dark:bg-gray-950 text-gray-900 dark:text-white transition-colors duration-300">
  <div class="max-w-7xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="col-span-1 md:col-span-2">
        <h3 class="text-2xl font-bold mb-4">Core</h3>
        <p class="text-gray-600 dark:text-gray-400 mb-4 max-w-md">
          Full-stack developer passionate about creating innovative solutions and clean, maintainable code.
        </p>
        <div class="flex space-x-4">
          <a 
            href="https://github.com/coredev-uk" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
          >
            <span class="sr-only">GitHub</span>
            <Icon name="mdi:github" class="h-6 w-6" />
          </a>
          <a 
            href="https://linkedin.com/in/-paulthompson/" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
          >
            <span class="sr-only">LinkedIn</span>
            <Icon name="mdi:linkedin" class="h-6 w-6" />
          </a>
          <a 
            href="https://x.com/coredev_uk" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
          >
            <span class="sr-only">X (Twitter)</span>
            <Icon name="simple-icons:x" class="h-6 w-6" />
          </a>
          <a 
            href="mailto:contact@coredev.uk" 
            class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors"
          >
            <span class="sr-only">Email</span>
            <Icon name="heroicons:envelope" class="h-6 w-6" />
          </a>
        </div>
      </div>
      
      <div>
        <h4 class="text-lg font-semibold mb-4">Quick Links</h4>
        <ul class="space-y-2">
          <li><a href="/projects" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors">Projects</a></li>
          <li><a href="/blog" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors">Blog</a></li>
        </ul>
      </div>
    </div>
    
    <div class="mt-8 pt-8 border-t border-gray-300 dark:border-gray-800 text-center">
      <p class="text-gray-500 dark:text-gray-500">
        © {new Date().getFullYear()} Core. All rights reserved.
      </p>
      {COMMIT_SHA !== 'unset' && (
        <p class="text-gray-500 dark:text-gray-500 text-sm mt-2 flex items-center justify-center space-x-2">
          <Icon name="mdi:source-commit" class="w-4 h-4" aria-hidden="true" />
          <a 
            href={`https://github.com/coredev-uk/coredev.uk/commit/${COMMIT_SHA}`} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-primary-600 dark:text-primary-300 hover:underline"
          >
            {COMMIT_SHA.substring(0, 7)}
          </a>
        </p>
      )}
    </div>
  </div>
</footer>
